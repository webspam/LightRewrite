<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kaer Morhen -->
      <overrides profile_name="Default"
                 weight="10">
        <!-- Castle Interior -->
        <matches>
          <any>
            <match type="layer">levels\kaer_morhen\env_global_pbr\castle\</match>
            <match type="layer">levels\kaer_morhen\kaer_morhen_valley\castle_interior\</match>
          </any>
        </matches>

        <!-- Shadows -->
        <override tag_name="LR_KaerMorhen_Shadows"
                  label="kaer_morhen_shadows">
          <shadows fade_distance="40"
                   fade_range="30" />
        </override>

        <!-- Wall Torch -->
        <override tag_name="LR_KaerMorhen_WallTorch"
                  label="kaer_morhen_wall_torch"
                  brightness="20">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <colour r="255"
                  g="255"
                  b="255" />
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_KaerMorhen_CandelabraComplex"
                  label="kaer_morhen_candelabra_complex"
                  brightness="26"
                  radius="6"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <colour r="255"
                  g="250"
                  b="245" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Large Candle Holder A -->
        <override tag_name="LR_KaerMorhen_CandleHolderLargeWoodAComplex"
                  label="kaer_morhen_candle_holder_large_wood_a_complex"
                  use_spotlight_colour="true">
          <match mode="exact">candle_holder_large_wood_a_complex.w2ent</match>
          <light index="0"
                 brightness="8"
                 radius="5.5" />
          <light index="1"
                 brightness="5"
                 radius="2" />
          <light index="2"
                 brightness="5"
                 radius="2" />
          <shadows casting_mode="Normal" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Large Candle Holder B -->
        <override tag_name="LR_KaerMorhen_CandleHolderLargeWoodBComplex"
                  label="kaer_morhen_candle_holder_large_wood_b_complex"
                  brightness="7.76"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
        </override>

        <!-- Hearth -->
        <!-- <override tag_name="LR_KaerMorhen_BathhouseFloorBrazier"
                  label="kaer_morhen_bathhouse_floor_brazier">
          <match mode="exact">bathhouse_floor_brazier.w2ent</match>
        </override> -->

        <!-- Hearth Table Candle -->
        <override tag_name="LR_KaerMorhen_HearthTableCandles"
                  label="kaer_morhen_hearth_table_candles"
                  radius="10">
          <match mode="exact">candle_small_group_melted_e_complex.w2ent</match>
          <colour r="255"
                  g="250"
                  b="245" />
        </override>

        <!-- Tower Chamber Brazier -->
        <!-- levels\kaer_morhen\kaer_morhen_valley\castle_interior\q403_avallach_chamber\q403_avallach_chamber.w2l -->
        <override tag_name="LR_KaerMorhen_TowerChamber_Brazier"
                  label="kaer_morhen_tower_chamber_brazier">
          <match mode="exact">braziers_floor_square.w2ent</match>
          <colour r="255"
                  g="255"
                  b="255" />
        </override>

        <override tag_name="LR_KaerMorhen_ChandelierBright"
                  brightness="50"
                  attenuation="0.9">
          <match mode="exact">chandelier_bright.w2ent</match>
          <match type="layer"
                 mode="exact">levels\kaer_morhen\kaer_morhen_valley\castle_interior\lights.w2l</match>
          <offset x="0"
                  y="0"
                  z="-1.46" />
        </override>
      </overrides>


      <!-- Castle Storage -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\kaer_morhen\kaer_morhen_valley\castle_interior\castle_storage_interior.w2l</match>
        </matches>

        <override tag_name="LR_KaerMorhen_torch_wall_metal_fake_shadow_w2ent"
                  label="kaer_morhen_torch_wall_metal_fake_shadow_w2ent">
          <match mode="exact">torch_wall_metal_fake_shadow.w2ent</match>
          <spotlight attenuation="1">
            <colour r="255"
                    g="255"
                    b="255" />
          </spotlight>
        </override>

        <override tag_name="LR_KaerMorhen_candle_holder_large_wood_a_w2ent"
                  label="kaer_morhen_candle_holder_large_wood_a_w2ent"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_a.w2ent</match>
          <shadows casting_mode="Normal" />
          <colour r="255"
                  g="255"
                  b="255" />
        </override>

        <!-- Fireplace - Tutorial -->
        <override tag_name="LR_KaerMorhen_Tutorial_fireplace"
                  label="kaer_morhen_tutorial_fireplace"
                  brightness="75"
                  radius="6.4"
                  attenuation="1">
          <match mode="exact">fireplace_grate.w2ent</match>
          <match type="layer"
                 mode="exact">levels\kaer_morhen\env_global_pbr\castle\bonefire.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>