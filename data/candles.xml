<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <!-- Candle defaults -->
    <light_rewrite>
      <!-- Turn on shadow casting & drastically reduce secondary light radius -->
      <overrides profile_name="Default"
                 weight="2">
        <!-- Small group D complex -->
        <override tag_name="LR_candle_small_group_melted_d_complex"
                  label="candle_small_group_melted_d_complex">
          <match mode="exact">candle_small_group_melted_d_complex.w2ent</match>
          <light index="0">
            <shadows casting_mode="Normal" />
          </light>
          <light index="1"
                 radius="2">
            <shadows casting_mode="Normal" />
          </light>
        </override>

        <!-- Small group C -->
        <override tag_name="LR_candle_small_group_melted_c"
                  label="candle_small_group_melted_c">
          <match>candle_small_group_melted_c</match>
          <light index="0">
            <shadows casting_mode="Normal" />
          </light>
          <light index="1"
                 radius="2.25">
            <shadows casting_mode="Normal" />
          </light>
          <light index="2"
                 radius="2.25">
            <shadows casting_mode="Normal" />
          </light>
        </override>

        <!-- Small group B complex - RT/PT only dual-light -->
        <!-- Remastered allows the spotlight to be used - can cast RT/PT shadows. -->
        <!-- <override tag_name="LR_candle_small_group_melted_b_complex"
                  label="candle_small_group_melted_b_complex"
                  radius="5">
          <match mode="exact">candle_small_group_melted_b_complex.w2ent</match>
          <spotlight brightness="5">
            <offset x="0.076"
                    y="-0.0225"
                    z="0.13" />
          </spotlight>
        </override> -->
      </overrides>
    </light_rewrite>
  </custom>
</redxml>