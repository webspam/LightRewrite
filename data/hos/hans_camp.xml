<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- WARNING: 2 conflicting duplicate(s) were found. All duplicates are in Default_Duplicates overrides block(s) below. -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\q603\mercenary_camp.w2l</match>
        </matches>
        <override tag_name="LR_HansCidaris_Brazier"
                  label="hans_cidaris_brazier"
                  brightness="60"
                  radius="6"
                  attenuation="1">
          <match mode="exact">braziers_floor_square_noshadow.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="20" />
        </override>

        <override tag_name="LR_HansCidaris_Torch"
                  label="hans_cidaris_torch"
                  brightness="20"
                  attenuation="1">
          <match mode="exact">torch_hand_long.w2ent</match>
