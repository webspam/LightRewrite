<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">dlc\ep1\levels\novigrad\locations\q601\olgierd_mansion\</match>
        </matches>

        <!-- Shadow & colour reset -->
        <override tag_name="LR_OlgierdMansion_Shared"
                  label="olgierd_mansion_shared">
          <colour r="255"
                  g="250"
                  b="245" />
          <shadows casting_mode="Normal"
                   fade_distance="20"
                   fade_range="30" />
        </override>

        <!-- Wall torch (Front) -->
        <override tag_name="LR_OlgierdMansion_torch_wall_metal_bounce"
                  label="olgierd_mansion_torch_wall_metal_bounce"
                  brightness="20"
                  radius="4.5">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <!-- <match type="layer" mode="exact">dlc\ep1\levels\novigrad\locations\q601\olgierd_mansion\house_lights\interior_lights_house_intact.w2l</match> -->
        </override>

        <!-- Wall single-candle holders -->
        <override tag_name="LR_OlgierdMansion_candle_holder_wall_complex_b"
                  label="olgierd_mansion_candle_holder_wall_complex_b"
                  brightness="6"
                  radius="4"
                  attenuation="1">
          <match mode="exact">candle_holder_wall_complex_b.w2ent</match>
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <override tag_name="LR_OlgierdMansion_candle_holder_large_wood_b_complex"
                  label="olgierd_mansion_candle_holder_large_wood_b_complex"
                  brightness="16"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
        </override>

        <override tag_name="LR_OlgierdMansion_candle_holder_large_wood_a_complex"
                  label="olgierd_mansion_candle_holder_large_wood_a_complex">
          <match mode="exact">candle_holder_large_wood_a_complex.w2ent</match>
          <light index="0"
                 radius="5">
          </light>
          <light index="1"
                 radius="2.5">
          </light>
          <light index="2"
                 radius="2.5">
          </light>
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <override tag_name="LR_OlgierdMansion_candelabra_complex"
                  label="olgierd_mansion_candelabra_complex"
                  brightness="26"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Exterior Stables -->
        <!-- Candle on Shelf -->
        <override tag_name="LR_OlgierdMansion_Candle_Shelf"
                  label="olgierd_mansion_candle_shelf"
                  radius="6">
          <match mode="exact">candle_shelf.w2ent</match>
          <!-- <match type="layer" mode="exact">dlc\ep1\levels\novigrad\locations\q601\olgierd_mansion\house\interior.w2l</match> -->
        </override>
        <!-- Lamp -->
        <override tag_name="LR_OlgierdMansion_hanging_lamp_holder"
                  label="olgierd_mansion_hanging_lamp_holder"
                  brightness="16"
                  radius="6">
          <match mode="exact">hanging_lamp_holder.w2ent</match>
          <!-- <match type="layer" mode="exact">dlc\ep1\levels\novigrad\locations\q601\olgierd_mansion\interior_lights.w2l</match> -->
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>