<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\poi\graveyard\lights.w2l</match>
        </matches>
        <override tag_name="LR_UpperMill_Church_CandleC">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <light index="0"
                 radius="6.5" />
        </override>

        <override tag_name="LR_UpperMill_Church_CandleB"
                  radius="6.5">
          <match mode="exact">candle_med_b_complex.w2ent</match>
        </override>

        <!-- Candleholder - Large B -->
        <override tag_name="LR_UpperMill_Church_CandleHolderB"
                  brightness="9"
                  radius="5.5"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
          <offset x="0"
                  y="0"
                  z="1.94" />
        </override>

        <!-- Candleholder - Large A -->
        <override tag_name="LR_UpperMill_Church_CandleHolderA"
                  rewriter_type="LRT_Candle"
                  brightness="3.3">
          <match mode="exact">candle_holder_large_wood_a_complex.w2ent</match>
          <light index="0"
                 radius="4" />
          <light index="1"
                 radius="2.5" />
          <light index="2"
                 radius="2.5" />
          <spotlight attenuation="1">
            <lum exclude_scene="true" />
          </spotlight>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.12" />
        </override>

        <!-- Hanging Lamp - Pointlight has wrong LUM -->
        <override tag_name="LR_HoSPoI_Graveyard_HangingLamp">
          <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
          <spotlight brightness="15">
            <offset x="0"
                    y="0"
                    z="-0.18" />
          </spotlight>
        </override>
      </overrides>


      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_UpperMill_TorchHand"
                  radius="5">
          <match mode="exact">torch_hand.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\ep1\living_world\poi\ep1_poi_01\loot.w2l</match>
        </override>
      </overrides>

      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_UpperMill_Church_LampStanding"
                  brightness="15"
                  radius="5"
                  attenuation="1">
          <match mode="exact">lamp_standing_complex.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\village_by_lake\stone_windmill\exterior.w2l</match>
          <shadows fade_distance="30.19"
                   fade_range="19.99" />
          <colour r="255"
                  g="250"
                  b="245" />
          <spotlight brightness="0"
                     attenuation="1">
            <offset x="0"
                    y="0"
                    z="-0.14" />
          </spotlight>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>