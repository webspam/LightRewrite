<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- HoS Sewers -->
        <matches>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\q601\sewers\lights.w2l</match>
        </matches>

        <!-- Shadows -->
        <override tag_name="LR_HoSSewer_Shadows">
          <shadows casting_mode="Normal"
                   fade_distance="30"
                   fade_range="20" />
        </override>

        <!-- Wall Torch -->
        <override tag_name="LR_HoSSewer_Torch_Wall"
                  brightness="40"
                  radius="7.5"
                  attenuation="1">
          <match>torch_wall</match>
        </override>

        <!-- Lamp -->
        <override tag_name="LR_HoSSewer_Hanging_Lamp"
                  brightness="80"
                  radius="8"
                  attenuation="1">
          <match mode="exact">hanging_lamp_complex_serwers.w2ent</match>
          <offset x="0"
                  y="0"
                  z="-0.14" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>