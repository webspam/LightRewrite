<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>

      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\mq6001_merchant_camp\lights.w2l</match>
        </matches>
        <override tag_name="LR_UpperMill_CandelabraStanding"
                  brightness="9.52"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_standing.w2ent</match>
          <offset x="0"
                  y="0"
                  z="1.97" />
        </override>

        <override tag_name="LR_UpperMill_CandelabraNoshadow"
                  brightness="10.23"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_noshadow.w2ent</match>
          <offset x="0"
                  y="0"
                  z="0.82" />
        </override>

        <override tag_name="LR_UpperMill_LampStanding"
                  brightness="15"
                  radius="5"
                  attenuation="1">
          <match mode="exact">lamp_standing_complex.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="20" />
          <spotlight attenuation="1">
            <lum exclude_scene="true" />
            <offset x="0"
                    y="0"
                    z="-0.12" />
          </spotlight>
        </override>
      </overrides>

      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_SouthOfUpperMill_Fireplace"
                  brightness="30"
                  radius="7.5">
          <match mode="exact">coal_big_fire_complex.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\village_by_lake\lake_houses_interiors\lights.w2l</match>
          <offset x="0"
                  y="0"
                  z="0.58" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>
      </overrides>


      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_UpperMill_HangingLampHolder"
                  brightness="15"
                  radius="5"
                  attenuation="1">
          <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\village_by_lake\stone_windmill\lights.w2l</match>
          <shadows fade_distance="30"
                   fade_range="20" />
          <spotlight brightness="15"
                     attenuation="1">
            <lum exclude_scene="true" />
          </spotlight>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>