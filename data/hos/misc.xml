<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Hearts of Stone Misc / POI -->
      <overrides profile_name="Default"
                 weight="10">

        <!-- Lighthouse colour default -->
        <override tag_name="LR_HoSLighthouse_Colour"
                  label="HoS_Lighthouse_Colour">
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\poi\lighthouse\fx.w2l</match>
          <colour r="255"
                  g="250"
                  b="245" />
        </override>

        <!-- Beach House Basement -->
        <override tag_name="LR_HoSBeachHouse_HangingLantern"
                  label="hos_beach_house_hanging_lantern"
                  brightness="40"
                  attenuation="1">
          <match mode="exact">hanging_lamp_holder.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\poi\abandoned_house_beach_poi\fx.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>