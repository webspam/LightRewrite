<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Military camp SW from Olgierd's Mansion -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">levels\novigrad\gustfields\gf08_military_camp\</match>
        </matches>

        <!-- All shadows -->
        <override tag_name="LR_gf08_military_camp_shadows"
                  label="gf08_military_camp_shadows">
          <shadows fade_distance="30"
                   fade_range="20" />
        </override>

        <override tag_name="LR_gf08_military_camp_Campfire"
                  label="gf08_military_camp_campfire"
                  radius="7.5"
                  attenuation="0.85">
          <match mode="exact">campfire_01.w2ent</match>
          <offset x="0"
                  y="0"
                  z="0.24" />
        </override>
      </overrides>


      <!-- Vineyards south of Olgierd's Mansion -->
      <overrides profile_name="Default"
                 weight="10">
        <override tag_name="LR_gf16_vineyards_Campfire"
                  label="gf16_vineyards_campfire"
                  radius="7.5"
                  attenuation="0.9">
          <match mode="exact">campfire_01.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\gustfields\gf16_vineyards\decoration.w2l</match>
          <shadows fade_distance="30"
                   fade_range="20" />
        </override>
      </overrides>

      <!-- Honeymead Estate -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">levels\novigrad\gustfields\gf25_noblemans_estate_2\</match>
          <!-- interrior.w2l -->
          <!-- lights.w2l -->
        </matches>

        <override tag_name="LR_Honeymead_Candelabra"
                  label="honeymead_candelabra"
                  brightness="10.24"
                  radius="6.5"
                  attenuation="0.95">
          <match>candelabra</match>
        </override>

        <override tag_name="LR_Honeymead_CandelabraOnAStick"
                  label="honeymead_candelabra_on_a_stick"
                  brightness="9.52"
                  radius="6.5"
                  attenuation="0.95">
          <match>candelabra_standing</match>
        </override>

        <override tag_name="LR_Honeymead_Chandelier"
                  label="honeymead_chandelier"
                  brightness="30"
                  radius="6.5"
                  attenuation="0.85">
          <match>chandelier</match>
        </override>
      </overrides>

    </light_rewrite>
  </custom>
</redxml>