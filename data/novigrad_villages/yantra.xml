<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Yantra -->
      <overrides profile_name="Default"
                 weight="10">
        <matches>
          <!-- levels\novigrad\gustfields\gf23_farmersvillage_02\lights_interior.w2l -->
          <!-- levels\novigrad\gustfields\gf23_farmersvillage_02\lights.w2l -->
          <match type="layer">levels\novigrad\gustfields\gf23_farmersvillage_02\</match>
        </matches>

        <!-- Candleholder Small -->
        <override tag_name="LR_Yantra_CandleholderSmallMeltedFakeShadow"
                  label="yantra_candleholder_small_melted_fake_shadow"
                  radius="5">
          <match mode="exact">candleholder_small_melted_fake_shadow_complex.w2ent</match>
        </override>

        <!-- Wall Lantern -->
        <override tag_name="LR_Yantra_HangingLampHolder"
                  label="yantra_hanging_lamp_holder"
                  brightness="15"
                  radius="5"
                  attenuation="1">
          <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Hanging Lamp -->
        <override tag_name="LR_Yantra_HangingLamp"
                  label="yantra_hanging_lamp"
                  brightness="15"
                  radius="6">
          <match mode="exact">hanging_lamp_complex.w2ent</match>
          <shadows fade_distance="10"
                   fade_range="10" />
          <colour r="255"
                  g="250"
                  b="245" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Torch on a Stick -->
        <override tag_name="LR_Yantra_TorchHandLong"
                  label="yantra_torch_hand_long"
                  radius="5">
          <match mode="exact">torch_hand_long_complex.w2ent</match>
          <shadows fade_range="20" />
        </override>
        <!-- Horn Chandelier -->
        <override tag_name="LR_Yantra_HornChandelier"
                  label="yantra_horn_chandelier"
                  brightness="30"
                  radius="7"
                  attenuation="1">
          <match mode="exact">horn_chandelier.w2ent</match>
          <shadows casting_mode="Normal" />
        </override>

        <!-- Kitchen Stove -->
        <override tag_name="LR_Yantra_KitchenStove"
                  label="yantra_kitchen_stove">
          <match mode="exact">coal_small_double_spotlight_complex.w2ent</match>
          <spotlight index="0"
                     attenuation="1"
                     radius="1.66">
            <!-- <shadows casting_mode="Normal" />
            <offset x="0.048"
                    y="0.070501"
                    z="0.32" /> -->
          </spotlight>
          <spotlight index="1"
                     radius="5.5"
                     outerAngle="120">
            <!-- Softer shadow hack -->
            <shadows casting_mode="Normal"
                     fade_distance="0.01"
                     fade_range="20" />
            <offset x="-0.015"
                    y="0.19"
                    z="0.43" />
          </spotlight>
        </override>
      </overrides>


      <!-- Cauldron -->
      <overrides profile_name="Default"
                 weight="10">
        <override tag_name="LR_Yantra_Cauldron"
                  label="yantra_cauldron">
          <match mode="exact">stand_mw_cooking_big_cauldron_ap.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\communities\gustfields\farm_village_2\house3\ap.w2l</match>
          <shadows casting_mode="Normal"
                   fade_distance="0.01"
                   fade_range="50" />
          <offset x="0"
                  y="0"
                  z="0.17" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>