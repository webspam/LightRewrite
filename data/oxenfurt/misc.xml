<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Oxenfurt miscellaneous -->
      <overrides profile_name="Default"
                 weight="20">
        <!-- House next to the barber -->
        <override tag_name="LR_Oxenfurt_Building_A"
                  label="oxenfurt_building_a_candelabra"
                  brightness="8"
                  radius="5">
          <match mode="exact">candelabra.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\white_bridge\building_a\fx_lights.w2l</match>
          <shadows casting_mode="Normal" />
        </override>
      </overrides>

      <!-- Barber shop -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\white_bridge\barber_shop\interior_decorations_ns.w2l</match>
        </matches>

        <!-- All shadows -->
        <override tag_name="LR_Oxenfurt_Barber_Shadows"
                  label="oxenfurt_barber_shadow">
          <shadows fade_distance="12.5" />
        </override>

        <!-- Candle Holder -->
        <override tag_name="LR_Oxenfurt_Barber_Candles"
                  label="oxenfurt_barber_candle"
                  brightness="5">
          <match mode="exact">baron_candle_holder.w2ent</match>
          <shadows casting_mode="Normal" />
          <offset x="0"
                  y="0"
                  z="1.01" />
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_Oxenfurt_Barber_Candelabra"
                  label="oxenfurt_barber_candelabra"
                  brightness="10.23"
                  attenuation="1">
          <match mode="exact">candelabra.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>