<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Oxenfurt prison -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\oxenfurt_suburbian\q310_prison\light_source.w2l</match>
        </matches>

        <!-- Warden's room -->
        <override tag_name="LR_Oxenfurt_Prison_candelabra_complex"
                  brightness="18"
                  radius="5"
                  attenuation="1">
          <match>candelabra</match>
          <shadows fade_distance="12.5"
                   fade_range="7.5" />
          <offset x="0"
                  y="0"
                  z="0.92" />
          <spotlight brightness="0" />
        </override>

        <!-- Lantern in stairwell -->
        <override tag_name="LR_Oxenfurt_Prison_lamp_standing_complex"
                  brightness="10"
                  radius="4.25">
          <match mode="exact">lamp_standing_complex.w2ent</match>
          <shadows fade_distance="12.5"
                   fade_range="10" />
          <offset x="0"
                  y="0"
                  z="-0.22" />
          <spotlight brightness="4"
                     radius="1.5" />
        </override>

        <!-- Braziers in cells / courtyard -->
        <override tag_name="LR_Oxenfurt_Prison_braziers_floor_square_bounce">
          <match mode="exact">braziers_floor_square_bounce.w2ent</match>
          <shadows fade_distance="20" />
          <colour r="255"
                  g="255"
                  b="255" />
          <spotlight>
            <colour r="255"
                    g="255"
                    b="255" />
          </spotlight>
        </override>

        <!-- Triple candle - missing shadows -->
        <override tag_name="LR_Oxenfurt_Prison_candle_small_group_melted_c_complex">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <shadows casting_mode="Normal" />
        </override>

        <!-- Wall torches in cells -->
        <override tag_name="LR_Oxenfurt_Prison_torch_wall_wooden_small_bounce"
                  brightness="20">
          <match mode="exact">torch_wall_wooden_small_bounce.w2ent</match>
          <colour r="255"
                  g="245"
                  b="240" />
        </override>

        <!-- Wall torches in cells -->
        <override tag_name="LR_Oxenfurt_Prison_torch_wall_metal_bounce"
                  brightness="20"
                  radius="6"
                  attenuation="1"
                  use_spotlight_colour="false">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <shadows fade_distance="15" />
          <colour r="255"
                  g="245"
                  b="240" />
        </override>
        <override tag_name="LR_Oxenfurt_Prison_braziers_floor_square"
                  brightness="60"
                  radius="7">
          <match mode="exact">braziers_floor_square.w2ent</match>
          <shadows fade_range="7.5" />
        </override>

        <!-- Guard room upstairs -->
        <override tag_name="LR_Oxenfurt_Prison_chandelier">
          <match mode="exact">chandelier.w2ent</match>
          <light index="0"
                 radius="5">
            <shadows casting_mode="Normal" />
          </light>
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>