<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- Oxenfurt city lights -->
        <matches>
          <match type="layer">levels\novigrad\white_bridge\ligths</match>
        </matches>

        <!-- Wall torches -->
        <override tag_name="LR_Oxenfurt_Wall_Torches"
                  label="oxenfurt_wall_torch"
                  brightness="20">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <shadows fade_distance="20" />
        </override>

        <!-- Wall braziers - city gates, exterior -->
        <override tag_name="LR_Oxenfurt_GateExterior_Brazier"
                  label="oxenfurt_gateexterior_brazier">
          <match mode="exact">braziers_wall_chain_bounce.w2ent</match>
          <offset x="-1.1"
                  y="0"
                  z="-0.83" />
        </override>

        <!-- Wall braziers - city gates, interior -->
        <override tag_name="LR_Oxenfurt_GateInterior_Brazier"
                  label="oxenfurt_gateinterior_brazier">
          <match mode="exact">braziers_wall_wire_bounce.w2ent</match>
          <offset x="-1.375"
                  y="0"
                  z="0.54" />
        </override>

        <!-- Hanging lamp holders - exterior -->
        <override tag_name="LR_Oxenfurt_HangingLamp"
                  label="oxenfurt_hanginglamp"
                  brightness="12"
                  radius="5">
          <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
          <colour r="255"
                  g="245"
                  b="240" />
        </override>

        <!-- Iron chandelier  -->
        <override tag_name="LR_Oxenfurt_ChandelierSmall"
                  label="oxenfurt_chandelier_small"
                  radius="6">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>


        <!-- Braziers - Floor, Square -->
        <override tag_name="LR_Oxenfurt_BraziersFloorSquare"
                  label="oxenfurt_braziers_floor_square">
          <match mode="exact">braziers_floor_square_bounce.w2ent</match>
          <shadows blend_factor="0.66" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>