<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Quest 603 -->
      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_Oxenfurt_Armoury_CandleholderFancy"
                  label="oxenfurt_armoury_candleholder_fancy"
                  radius="6.5">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\q603\interior_lights.w2l</match>
        </override>
      </overrides>

      <!-- Oxenfurt Armoury -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\white_bridge\armory\int_nonstat.w2l</match>
        </matches>
        <override tag_name="LR_Oxenfurt_Armoury_Candelabra"
                  label="oxenfurt_armoury_candelabra"
                  brightness="10.23"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra.w2ent</match>
        </override>

        <override tag_name="LR_Oxenfurt_Armoury_CandleholderFancy2"
                  label="oxenfurt_armoury_candleholder_fancy_2"
                  use_spotlight_colour="true">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <override tag_name="LR_Oxenfurt_Armoury_ChandelierSmallNoshadow"
                  label="oxenfurt_armoury_chandelier_small_noshadow"
                  brightness="30"
                  radius="5"
                  attenuation="1">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>