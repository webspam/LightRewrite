<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Torch defaults -->
      <overrides profile_name="Default"
                 weight="2">
        <!-- Wall torch -->
        <override tag_name="LR_torch_wall_metal"
                  label="torch_wall_metal"
                  brightness="20"
                  radius="5">
          <!--
          torch_wall_metal.w2ent
          torch_wall_metal_bounce.w2ent
          torch_wall_metal_noshadow.w2ent
          torch_wall_metal_staticshadow.w2ent
          -->
          <match>torch_wall_metal</match>
          <offset x="-0.25"
                  y="0"
                  z="0.51" />
        </override>

        <!-- Torch on a stick -->
        <override tag_name="LR_torch_hand_long"
                  label="torch_hand_long">
          <match>torch_hand_long</match>
          <offset x="0.03"
                  y="0"
                  z="0.56" />
        </override>

        <!-- Wall Torch - Wood -->
        <override tag_name="LR_torch_wall_wooden"
                  label="torch_wall_wooden">
          <match>torch_wall_wooden</match>
          <offset x="-0.283"
                  y="0"
                  z="0.56" />
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>