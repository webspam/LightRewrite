<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Isle of Mist -->
      <overrides profile_name="Default"
                 weight="20">
        <!-- Candles -->
        <override tag_name="LR_IsleOfMist_Candle"
                  label="isle_of_mist_candle"
                  brightness="30"
                  radius="7">
          <match>candle</match>
          <match type="layer">levels\island_of_mist\</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override>

        <!-- Red lantern (dock) -->
        <override tag_name="LR_IsleOfMist_Red_Lantern"
                  label="isle_of_mist_red_lantern"
                  radius="8">
          <match mode="exact">hanging_lantern_red.w2ent</match>
          <match type="layer"
                 mode="exact">levels\island_of_mist\island_of_mist\lights.w2l</match>
        </override>

        <!-- Hanging lamps -->
        <override tag_name="LR_IsleOfMist_Lantern"
                  label="hanging_lamp"
                  radius="9"
                  attenuation="1">
          <match>hanging_lamp</match>
          <match type="layer">levels\island_of_mist\</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>