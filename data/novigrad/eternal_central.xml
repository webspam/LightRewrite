<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Shrine of The Eternal Fire (central lights) -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\temple_island\temple_of_ethernal_fire.w2l</match>
        </matches>

        <!-- Radiates light from the middle of the archway above the overcompensating fire -->
        <override tag_name="LR_Edited_city_bouncelight_fire_w2ent"
                  label="edited_city_bouncelight_fire_w2ent">
          <match mode="exact">city_bouncelight_fire.w2ent</match>

          <lum exclude_scene="true" />
        </override>

        <!-- Centre shrine -->
        <override tag_name="LR_Edited_shrine_of_ethernal_fire_bounce_w2ent"
                  label="edited_shrine_of_ethernal_fire_bounce_w2ent"
                  use_spotlight_colour="true">
          <match mode="exact">shrine_of_ethernal_fire_bounce.w2ent</match>
          <light index="0"
                 brightness="150"
                 radius="4.71"
                 attenuation="0.7">
            <offset x="0"
                    y="0"
                    z="3" />
          </light>
          <light index="1"
                 brightness="125"
                 radius="3.89"
                 attenuation="0.7" />
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>