<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- Novigrad HV Warehouse -->
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\sq306_warehouse\interior.w2l</match>
        </matches>

        <override tag_name="LR_Novigrad_HvWarehouse_Interior">
          <shadows fade_distance="15"
                   fade_range="25" />
        </override>

        <!-- Candle Shelf -->
        <override tag_name="LR_Novigrad_HvWarehouse_CandleShelf"
                  brightness="12"
                  radius="5">
          <match mode="exact">candle_shelf.w2ent</match>
        </override>

        <!-- <match mode="exact">candle_small_group_melted_d.w2ent</match> -->
        <!-- <match mode="exact">candleholder_small_melted.w2ent</match> -->

      </overrides>
    </light_rewrite>
  </custom>
</redxml>