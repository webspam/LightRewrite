<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Golden Sturgeon Inn -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_harbour_district\golden_sturgeon_inn\lights.w2l</match>
        </matches>

        <!-- Force candle group -> single light -->
        <override tag_name="LR_GoldenSturgeon_Candle_Group_C"
                  brightness="12"
                  force_single_light="true">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <shadows fade_distance="15" />
        </override>
        <override tag_name="LR_GoldenSturgeon_CandleSmallGroupMelted"
                  brightness="10"
                  force_single_light="true">
          <match mode="exact">candle_small_group_melted_complex.w2ent</match>
        </override>

        <!-- No-shadow candle C -->
        <override tag_name="LR_GoldenSturgeon_Candle_Group_C_NoShadow"
                  radius="5">
          <match mode="exact">candle_small_group_melted_c_noshadow.w2ent</match>
        </override>

        <!-- Long distance shadows - downstairs on the right -->
        <override tag_name="LR_GoldenSturgeon_CandleholderSmallMeltedFakeShadowComplex">
          <match mode="exact">candleholder_small_melted_fake_shadow_complex.w2ent</match>
          <shadows fade_distance="15"
                   fade_range="15" />
        </override>

        <!-- Candle holder large -->
        <override tag_name="LR_GoldenSturgeon_CandleHolderLarge"
                  brightness="14"
                  radius="5"
                  attenuation="0.9">
          <match>candle_holder_large</match>
        </override>

        <!-- Horn Chandelier -->
        <override tag_name="LR_GoldenSturgeon_HornChandelier"
                  brightness="15"
                  radius="3"
                  attenuation="0.9">
          <match mode="exact">horn_chandelier.w2ent</match>
          <shadows casting_mode="Normal"
                   fade_distance="30"
                   fade_range="20" />
          <spotlight spawn="true"
                     brightness="5"
                     radius="8"
                     attenuation="0.9"
                     innerAngle="190"
                     outerAngle="135"
                     softness="1">
            <offset x="0"
                    y="0"
                    z="-0.74" />
          </spotlight>
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>