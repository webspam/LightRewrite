<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- Novigrad Harbour - Right side -->
        <matches>
          <match type="layer">levels\novigrad\novigrad\_harbour_district\harbour_deco_right_side\</match>
        </matches>

        <!-- Brazier -->
        <override tag_name="LR_Novigrad_HarbourRight_Brazier"
                  brightness="50">
          <match mode="exact">braziers_floor_square_bounce.w2ent</match>
          <spotlight attenuation="1" />
        </override>

        <!-- Lamp -->
        <override tag_name="LR_Novigrad_Harbour_Lamp"
                  brightness="15">
          <match mode="exact">lamp_standing_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_harbour_district\harbour_deco_right_side\lights.w2l</match>
        </override>
      </overrides>


      <!-- South Harbour -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_harbour_district\harbour_deco_foreland\lights.w2l</match>
        </matches>
        <!-- Brazier -->
        <override tag_name="LR_Novigrad_HarbourSouth_Brazier"
                  brightness="50">
          <match mode="exact">braziers_floor_square_bounce.w2ent</match>
          <shadows fade_distance="15.36"
                   fade_range="14.95" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>