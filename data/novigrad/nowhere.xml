<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Nowhere Inn -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">levels\novigrad\novigrad\nowhere_inn\</match>
        </matches>

        <!-- Chandelier has no shadows -->
        <override tag_name="LR_NowhereInn_Chandelier"
                  radius="6.5"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
          <shadows fade_distance="10"
                   fade_range="15"
                   casting_mode="Normal" />
          <offset x="0"
                  y="0"
                  z="0.45" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>