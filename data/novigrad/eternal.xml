<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- Shrine of The Eternal Fire -->
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\temple_island\fx.w2l</match>
        </matches>

        <!-- Mini hanging chandelier - walkway -->
        <override tag_name="LR_Eternal_Chandelier_Small"
                  brightness="30"
                  radius="5"
                  attenuation="0.9"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small_bounce.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="30"
                   casting_mode="Normal" />
          <offset x="0"
                  y="0"
                  z="0.3" />
          <colour r="255"
                  g="235"
                  b="220" />
          <spotlight brightness="10"
                     radius="5"
                     attenuation="1" />
        </override>

        <!-- Regular altar fire -->
        <override tag_name="LR_Eternal_Altar_Fire"
                  brightness="150"
                  radius="10">
          <match mode="exact">shrine_of_ethernal_fire_altar_spot.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="30" />
          <offset x="0"
                  y="0"
                  z="2.15" />
          <spotlight brightness="80"
                     radius="3.5"
                     innerAngle="271.5"
                     outerAngle="280">
            <offset x="0"
                    y="0"
                    z="2.15" />
          </spotlight>
        </override>

        <!-- Small central alter fire -->
        <override tag_name="LR_Eternal_Small_Fire"
                  brightness="125"
                  radius="7.5"
                  attenuation="0.8">
          <match mode="exact">shrine_of_ethernal_fire_altar_small_spot_bounce.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="30"
                   casting_mode="Normal" />
          <offset x="0"
                  y="0"
                  z="1.95" />
          <spotlight brightness="62"
                     radius="3.14159"
                     attenuation="0.9"
                     innerAngle="278"
                     outerAngle="285">
            <offset x="0"
                    y="0"
                    z="1.75" />
          </spotlight>
        </override>

        <!-- Large fires around the main building -->
        <override tag_name="LR_Eternal_Large">
          <match mode="exact">shrine_of_ethernal_fire_altar_wide_bounce.w2ent</match>
          <offset x="0"
                  y="0"
                  z="2.15" />
          <shadows fade_distance="60"
                   fade_range="20" />
          <spotlight brightness="100"
                     radius="5"
                     attenuation="0.7"
                     innerAngle="252"
                     outerAngle="264">
            <offset x="0"
                    y="0"
                    z="2.15" />
          </spotlight>
        </override>

        <!-- The Overcompensating Fire -->
        <override tag_name="LR_The_Overcompensating_Fire"
                  brightness="300"
                  radius="20"
                  attenuation="0.7"
                  force_cast_shadows="true">
          <match mode="exact">shrine_of_ethernal_fire_altar_wide_bounce.w2ent</match>
          <match_scale mode="larger"
                       scale="2" />
          <offset x="0"
                  y="0"
                  z="1.8" />
          <shadows fade_distance="60"
                   fade_range="20" />

          <!-- Ambient glow / shadow blurring -->
          <spotlight brightness="175"
                     radius="15"
                     attenuation="0.7"
                     innerAngle="215"
                     outerAngle="240">
            <offset x="0"
                    y="0"
                    z="1.84" />
          </spotlight>
        </override>
      </overrides>

      <!-- Temple Isle Bastions -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\temple_island\decorations_interior.w2l</match>
        </matches>

        <!-- Bastions -->
        <override tag_name="LR_Eternal_Bastion_Torch"
                  brightness="15"
                  radius="7.5"
                  attenuation="0.9">
          <match mode="exact">torch_wall_metal.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>