<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <any>
            <match type="layer"
                   mode="exact">levels\novigrad\novigrad\_novigrad_sewers\lights.w2l</match>
            <match type="layer"
                   mode="exact">levels\novigrad\novigrad\_novigrad_sewers\lightsources.w2l</match>
          </any>
        </matches>
        <override tag_name="LR_WhoresonArena_Torch"
                  brightness="14">
          <match>torch_wall_metal</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>