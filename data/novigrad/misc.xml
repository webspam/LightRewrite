<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">

        <!-- Cleaver's -->
        <override tag_name="LR_Cleavers_Candle"
                  label="cleavers_candle"
                  radius="5">
          <match mode="exact">candleholder_small_melted.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\q302\tasak_hq_interior_decoration_ns.w2l</match>
        </override>
        <override tag_name="LR_Cleavers_Candelabra"
                  label="cleavers_candelabra"
                  brightness="10"
                  radius="6"
                  attenuation="1">
          <match mode="exact">candelabra_standing.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\q302\tasak_hq.w2l</match>
          <shadows fade_distance="10"
                   fade_range="12.5" />
        </override>

        <!-- Misc Raw edits -->
        <override tag_name="LR_NovigradBrothelDistrict_BigCauldron"
                  label="edited_stand_mw_cooking_big_cauldron_ap"
                  brightness="40">
          <match mode="exact">stand_mw_cooking_big_cauldron_ap.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\communities\novigrad_brothel_district\misc\refugees_men.w2l</match>
        </override>

        <!-- Spotlight-only lamps -->
        <override tag_name="LR_HoS_NovigradLaundry_Lamp"
                  label="edited_lamp_standing_complex_one_light">
          <match mode="exact">lamp_standing_complex_one_light.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\q602_barn\laundry_house\lights.w2l</match>
          <spotlight brightness="15"
                     radius="5"
                     attenuation="1">
            <offset x="0"
                    y="0"
                    z="-0.18" />
          </spotlight>
        </override>
        <override tag_name="LR_HoS_NovigradWatermill_Lamp"
                  label="edited_lamp_standing_complex_one_light">
          <match mode="exact">lamp_standing_complex_one_light.w2ent</match>
          <match type="layer"
                 mode="exact">dlc\ep1\levels\novigrad\locations\q602_barn\watermill\lights.w2l</match>
          <spotlight brightness="15"
                     radius="5"
                     attenuation="1"
                     outerAngle="228.5">
            <offset x="0"
                    y="0"
                    z="-0.17" />
          </spotlight>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>