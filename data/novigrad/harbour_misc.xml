<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="75">
        <!-- House A -->
        <!-- Stove -->
        <override tag_name="LR_Novigrad_HouseA_Stove"
                  brightness="55"
                  attenuation="1">
          <match mode="exact">coal_small_double_spotlight.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_harbour_district\house_a\fx_lights.w2l</match>
          <shadows fade_distance="10"
                   fade_range="7.5" />
        </override>
        <!-- Candle on the right downstairs -->
        <override tag_name="LR_Novigrad_HouseA_CandleMedMelted"
                  brightness="4">
          <match mode="exact">candle_med_melted.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_harbour_district\house_a\fx_lights.w2l</match>
        </override>

        <!-- Ships -->
        <!-- Hanging Lamp -->
        <override tag_name="LR_Novigrad_Ships_HangingLamp"
                  brightness="20"
                  radius="5"
                  attenuation="1">
          <any>
            <match mode="exact">hanging_lamp_complex.w2ent</match>
            <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
          </any>
          <any>
            <match type="layer"
                   mode="exact">levels\novigrad\novigrad\_harbour_district\sq304_ship\lights.w2l</match>
            <match type="layer"
                   mode="exact">levels\novigrad\novigrad\q201_ships\lights.w2l</match>
          </any>
          <shadows fade_distance="15"
                   fade_range="15" />
        </override>
        <!-- Brazier -->
        <override tag_name="LR_Novigrad_Ships_Brazier"
                  brightness="60"
                  radius="5">
          <match mode="exact">braziers_floor_square_dynamic.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\q201_ships\lights.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>