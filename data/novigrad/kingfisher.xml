<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kingfisher Inn -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\zimorodek_inn\building\lights.w2l</match>
        </matches>

        <!-- Quin-Candleholder - Standing -->
        <override tag_name="LR_Kingfisher_LargeCandleHolderB"
                  label="kingfisher_largecandleholder_b"
                  brightness="7.76"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
          <offset x="0"
                  y="0"
                  z="2.1" />
        </override>

        <!-- Candle group near the side door -->
        <override tag_name="LR_Kingfisher_CandleGroupC"
                  label="kingfisher_candlegroup_c"
                  brightness="4.5">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <shadows fade_distance="25"
                   casting_mode="Normal" />
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_Kingfisher_CandelabraComplex"
                  label="kingfisher_candelabracomplex"
                  brightness="16"
                  radius="4"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <offset x="0"
                  y="0"
                  z="0.82" />
          <shadows fade_distance="15"
                   fade_range="10" />
          <spotlight radius="0.73"
                     innerAngle="0.01"
                     outerAngle="359.93">
            <offset x="0"
                    y="0"
                    z="0.37" />
          </spotlight>
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_Kingfisher_Candelabra"
                  label="kingfisher_candelabra"
                  radius="5">
          <match mode="exact">candelabra.w2ent</match>
        </override>

        <!-- Candle holder - single, short -->
        <override tag_name="LR_Kingfisher_CandleHolderFancy"
                  label="kingfisher_candleholderfancy"
                  radius="3.5">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <!-- Stage -->
        <override tag_name="LR_Kingfisher_StageFloorCandles"
                  label="kingfisher_stage_floor_candles">
          <any>
            <match mode="exact">candle_small_group_melted_d.w2ent</match>
            <match mode="exact">candle_small_group_melted_b.w2ent</match>
          </any>
          <light index="0"
                 radius="5" />
          <light index="1"
                 radius="1.5" />
        </override>

        <!-- Candelabra on a Stick - Penthouse -->
        <override tag_name="LR_Ultra_Kingfisher_Penthouse_CandleabraOnAStick"
                  radius="4.25"
                  attenuation="1">
          <match mode="exact">candelabra_standing_complex.w2ent</match>
          <lum exclude_scene="false" />
          <shadows fade_distance="15"
                   fade_range="15"
                   blend_factor="0.75" />
          <colour r="255"
                  g="250"
                  b="245" />
          <offset x="0"
                  y="0"
                  z="1.94" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>
      </overrides>

      <!-- Kingfisher Inn - First floor, Northeast Room (3) -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\zimorodek_inn\building\northeast_room_q310\lights.w2l</match>
        </matches>

        <!-- Candelabra -->
        <override tag_name="LR_Kingfisher3_CandelabraComplex"
                  label="kingfisher3_candelabracomplex"
                  brightness="17"
                  radius="2.65"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <offset x="0"
                  y="0"
                  z="0.82" />
          <spotlight brightness="8"
                     radius="1.1"
                     innerAngle="359.58"
                     outerAngle="360">
            <offset x="0"
                    y="0"
                    z="0.39" />
          </spotlight>
        </override>

        <!-- Candle holder - foot of bed -->
        <override tag_name="LR_Kingfisher3_CandleHolderFancy"
                  label="kingfisher3_candleholderfancy"
                  radius="3">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <!-- Floor candles -->
        <override tag_name="LR_Kingfisher3_FloorCandleD"
                  label="kingfisher3_floorcandle_d"
                  radius="3">
          <match mode="exact">candle_small_group_melted_d_complex.w2ent</match>
          <light index="1">
            <shadows casting_mode="None" />
          </light>
        </override>

        <!-- Floor candles -->
        <override tag_name="LR_Kingfisher3_FloorCandleA"
                  label="kingfisher3_floorcandle_a"
                  radius="3">
          <match mode="exact">candle_small_group_melted_complex.w2ent</match>
          <light index="1">
            <shadows casting_mode="None" />
          </light>
        </override>

        <!-- Floor candles -->
        <override tag_name="LR_Kingfisher3_FloorCandleC"
                  label="kingfisher3_floorcandle_c"
                  radius="3">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
        </override>

        <override tag_name="LR_Kingfisher3_Med_FloorCandle"
                  label="kingfisher3_med_floorcandle"
                  radius="3">
          <match mode="exact">candle_med_melted_complex.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>