<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="30">

        <!-- Vivaldi's -->
        <!-- Candelabra -->
        <override tag_name="LR_Vivaldis_Candelabra"
                  label="vivaldis_candelabra"
                  radius="3"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\main_square\vivaldis_bank\lights.w2l</match>
          <shadows fade_distance="15"
                   fade_range="12.5" />
        </override>
        <!-- Chandelier -->
        <override tag_name="LR_Novigrad_MainSquare_IronChandelier"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\main_square\lights_exterior.w2l</match>
          <shadows fade_distance="15"
                   fade_range="15" />
          <colour r="255"
                  g="250"
                  b="245" />
          <offset x="0"
                  y="0"
                  z="0.3" />
        </override>


        <!-- Top Notch Swords -->
        <override tag_name="LR_Novigrad_TopNotchSwords_IronChandelier"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small_bounce.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\main_square\main_square_armorer\lights.w2l</match>
          <shadows fade_distance="15"
                   fade_range="15" />
          <offset x="0"
                  y="0"
                  z="0.3" />
        </override>


        <!-- Torches - wall, metal -->
        <override tag_name="LR_Novigrad_MainSquare_TorchWallMetal"
                  radius="5">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\main_square\lights_exterior.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>