<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- Harbour Stables -->
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_harbour_district\poor_stables_port\lights.w2l</match>
        </matches>

        <override tag_name="LR_HarbourStables_CandleB"
                  radius="5">
          <match mode="exact">candle_small_group_melted_b.w2ent</match>
        </override>
        <override tag_name="LR_HarbourStables_Candleholder"
                  radius="5">
          <match mode="exact">candleholder_small_melted.w2ent</match>
        </override>
        <override tag_name="LR_HarbourStables_CandleC"
                  radius="5">
          <match mode="exact">candle_small_group_melted_c.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>