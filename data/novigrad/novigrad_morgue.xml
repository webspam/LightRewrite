<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Novigrad Morgue -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\q308_morgue\lights.w2l</match>
        </matches>

        <!-- All morgue shadows -->
        <override tag_name="LR_Novigrad_Morgue_Shadows"
                  label="novigrad_morgue_shadows">
          <shadows fade_distance="20"
                   fade_range="15"
                   blend_factor="0.8" />
        </override>

        <!-- Braziers -->
        <override tag_name="LR_Novigrad_Morgue_Brazier"
                  label="novigrad_morgue_brazier"
                  brightness="30"
                  radius="6.25"
                  attenuation="0.85">
          <match mode="exact">braziers_wall_wire.w2ent</match>
          <offset x="-1.5"
                  y="0"
                  z="0.5" />
        </override>

        <!-- Torches -->
        <override tag_name="LR_Novigrad_Morgue_Torch"
                  label="novigrad_morgue_torch"
                  brightness="20"
                  radius="5"
                  attenuation="1">
          <match mode="exact">torch_wall_metal.w2ent</match>
        </override>

        <!-- Candles -->
        <override tag_name="LR_Novigrad_Morgue_Candle"
                  brightness="6.6"
                  radius="3"
                  attenuation="1"
                  label="novigrad_morgue_candle">
          <match mode="startsWith">candle_small_group_melted_</match>
        </override>
        <!-- Candles - group of 3 -->
        <override tag_name="LR_Novigrad_Morgue_TriCandle"
                  brightness="7.76"
                  label="novigrad_morgue_tricandle">
          <match mode="exact">candle_small_group_melted_c_morgue.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>