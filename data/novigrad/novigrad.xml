<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Novigrad -->
      <overrides profile_name="Default"
                 weight="10">
        <matches>
          <match type="layer">levels\novigrad\novigrad\</match>
        </matches>

        <!-- All candles -->
        <override tag_name="LR_Novigrad_Candle"
                  label="novigrad_candle"
                  use_spotlight_colour="true">
          <any>
            <match>candle_small</match>
            <match>candle_med</match>
            <match>candle_tall</match>
            <match>candleholder_small</match>
            <match>candleholder_med</match>
            <match>candleholder_fancy</match>
            <match>candlestick_small</match>
            <match>baron_candle</match>
            <match>candle_jar</match>
            <match>candle_shelf</match>
          </any>
        </override>

        <!-- Townhouse candles -->
        <override tag_name="LR_Novigrad_PoorCandleC"
                  label="novigrad_poor_candle_c"
                  force_single_light="true">
          <!-- 2/3 point lights had tiny radii, and no shadows -->
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\_novigrad_poor_district\building_interior_lights.w2l</match>
          <shadows casting_mode="Normal" />
        </override>

        <!-- Campfires -->
        <override tag_name="LR_Novigrad_Campfire"
                  label="novigrad_campfire"
                  brightness="90"
                  radius="12"
                  attenuation="0.85">
          <match mode="exact">campfire_02_cave.w2ent</match>
          <any>
            <match type="layer">levels\novigrad\novigrad\_harbour_district\</match>
            <match type="layer">levels\novigrad\novigrad\_novigrad_brothel_district\</match>
          </any>
        </override>
        <override tag_name="LR_Novigrad_Campfire01"
                  label="novigrad_campfire_01"
                  brightness="60"
                  radius="9"
                  attenuation="0.9">
          <match mode="exact">campfire_01.w2ent</match>
        </override>

        <!-- Lamps -->
        <override tag_name="LR_Novigrad_Lamp"
                  label="novigrad_lamp"
                  brightness="15"
                  radius="4.5">
          <match mode="exact">hanging_lamp.w2ent</match>
        </override>

        <!-- Red Lanterns -->
        <override tag_name="LR_Novigrad_HangingLanternRed"
                  label="novigrad_hanging_lantern_red">
          <match mode="exact">hanging_lantern_red.w2ent</match>
          <!-- Lowest it can go before the light pokes outside the mesh -->
          <offset x="0"
                  y="0"
                  z="-1.19" />
        </override>

        <!-- Crippled Kate's -->
        <override tag_name="LR_Edited_baron_candle_holder_noshadow_dynamic_w2ent"
                  label="edited_baron_candle_holder_noshadow_dynamic_w2ent">
          <match mode="exact">baron_candle_holder_noshadow_dynamic.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\pegleg_peggys_bordello\stage\decoration_interior.w2l</match>
          <shadows casting_mode="Normal" />
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>