<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Vizima Castle -->
      <overrides profile_name="Default"
                 weight="10">
        <matches>
          <match type="layer">levels\wyzima_castle\</match>
        </matches>

        <override tag_name="LR_Wyzima_Torch"
                  brightness="30"
                  radius="6.5"
                  attenuation="1">
          <match>torch</match>
          <shadows fade_distance="20"
                   fade_range="20" />
          <colour r="240"
                  g="245"
                  b="255" />
          <offset x="-0.276253"
                  y="0"
                  z="0.58" />
        </override>

        <override tag_name="LR_Wyzima_Brazier"
                  brightness="50">
          <match>brazier</match>
          <shadows fade_distance="20"
                   fade_range="20" />
        </override>

        <override tag_name="LR_Wyzima_Chandelier"
                  brightness="65"
                  radius="15"
                  attenuation="1">
          <match>chandelier</match>
          <shadows fade_distance="25"
                   fade_range="20" />
        </override>

        <override tag_name="LR_Wyzima_Candelabra"
                  brightness="30"
                  radius="6"
                  attenuation="1">
          <match>candelabra</match>
          <shadows fade_distance="20"
                   fade_range="20" />
        </override>

        <!-- Tree Lantern -->
        <override tag_name="LR_Wyzima_Tree_Lantern"
                  brightness="100"
                  attenuation="1">
          <match mode="exact">hanging_lamp.w2ent</match>
          <!-- levels\wyzima_castle\wyzima_castle\garden_syfilis.w2l -->
          <offset x="0"
                  y="0"
                  z="-0.2" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>