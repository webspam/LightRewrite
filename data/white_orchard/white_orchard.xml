<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- White Orchard -->
      <overrides profile_name="Default"
                 weight="10">
        <!-- Shared filters that apply to all overrides in this group -->
        <matches>
          <!-- Entities whose layer path starts with "levels\prolog_village\" -->
          <match type="layer">levels\prolog_village\</match>
          <!-- Add more matches here, and both must match -->
        </matches>

        <!-- All candles in White Orchard -->
        <override tag_name="LR_WhiteOrchard_Candle"
                  label="white_orchard_candle"
                  radius="5">
          <!-- Match all entities with a file name starting with "candle" -->
          <match>candle</match>
          <!-- Set the light colour to a more bluish white - ENV fight -->
          <colour r="255"
                  g="250"
                  b="245" />
          <shadows fade_distance="10"
                   fade_range="12.5"
                   casting_mode="Normal" />
        </override>

        <!-- Hanging lamps -->
        <override tag_name="LR_HangingLamp"
                  label="hanging_lamp"
                  radius="5"
                  attenuation="1">
          <match>hanging_lamp</match>
          <offset x="0"
                  y="0"
                  z="-0.09" />
        </override>

        <!-- Campfires -->
        <override tag_name="LR_WhiteOrchard_Campfire"
                  label="white_orchard_campfire"
                  brightness="50">
          <match mode="contains">campfire</match>
        </override>
        <!-- Braziers -->
        <override tag_name="LR_Brazier"
                  label="brazier"
                  brightness="40"
                  radius="10"
                  attenuation="1.0">
          <match>brazier</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override>

        <!-- Candelabras -->
        <override tag_name="LR_Candelabra"
                  label="candelabra"
                  brightness="8"
                  radius="10"
                  attenuation="1.0">
          <match>candelabra</match>
          <shadows fade_distance="15"
                   fade_range="7.5"
                   blend_factor="1" />
        </override>

        <!-- Campfires -->
        <override tag_name="LR_Campfire"
                  label="campfire"
                  brightness="50"
                  radius="12"
                  attenuation="0.85">
          <match>campfire</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override>

        <!-- Chandeliers -->
        <override tag_name="LR_Chandelier"
                  label="chandelier"
                  brightness="12"
                  radius="18"
                  attenuation="1.0">
          <match>chandelier</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override>

        <override tag_name="LR_WhiteOrchard_HornChandelier"
                  label="white_orchard_horn_chandelier"
                  brightness="14"
                  radius="8"
                  attenuation="1.0">
          <match>horn_chandelier</match>
          <shadows fade_distance="20"
                   fade_range="15"
                   casting_mode="Normal" />
        </override>

        <!-- Wall torches (Cemetary & Nilfgaard Captain) -->
        <override tag_name="LR_WhiteOrchard_WallTorches"
                  label="white_orchard_wall_torches"
                  brightness="20"
                  radius="6"
                  attenuation="1">
          <match mode="exact">torch_wall_metal.w2ent</match>
        </override>

        <!-- Stoves -->
        <override tag_name="LR_WhiteOrchard_Stove"
                  label="white_orchard_stove">
          <match mode="exact">coal_small_double_spotlight_complex.w2ent</match>
          <spotlight index="0"
                     radius="2.5"
                     attenuation="1" />
          <spotlight index="1"
                     radius="5"
                     attenuation="1" />
        </override>

        <!-- Cooking fire -->
        <override tag_name="LR_WhiteOrchard_CookingFire"
                  label="white_orchard_cooking_fire"
                  radius="5.5">
          <match mode="exact">stand_mw_cooking_</match>
          <offset x="0"
                  y="0"
                  z="0.25" />
        </override>

        <!-- Forge -->
        <override tag_name="LR_WhiteOrchard_Forge"
                  label="white_orchard_forge"
                  radius="5.5">
          <match mode="exact">ob_forge_px.w2ent</match>
          <shadows fade_distance="25"
                   fade_range="20" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>