<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Torches in White Orchard -->
      <overrides profile_name="Default"
                 weight="10">
        <!-- No group-wide filter for these `overrides` -->

        <override tag_name="LR_WhiteOrchard_Torch"
                  brightness="22.5"
                  radius="7.5"
                  attenuation="1.0">
          <!-- Use `any` groups to match any single match -->
          <any>
            <!-- Matches when the entity is in white orchard OR Road Lights DLC ... -->
            <match type="layer">levels\prolog_village\</match>
            <match type="layer">dlc\dlctest1\levels\prolog_village\</match>
          </any>
          <!-- ... AND its `w2ent` file name starts with `torch` -->
          <match>torch_hand</match>
          <colour r="255"
                  g="250"
                  b="245" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>