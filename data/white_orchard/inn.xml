<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <!-- White Orchard Inn -->
        <matches>
          <match type="layer">levels\prolog_village\village\tavern\</match>
        </matches>

        <!-- Candle shadows -->
        <override tag_name="LR_WhiteOrchard_Inn_CandleB"
                  label="white_orchard_inn_candle_b">
          <any>
            <match mode="exact">candle_small_group_melted_b_complex.w2ent</match>
            <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          </any>
          <!-- The inn is pretty long -->
          <shadows fade_distance="20" />
        </override>

        <!-- Smaller radius for tiny candleholders -->
        <override tag_name="LR_WhiteOrchard_Tavern_Candleholder_Small"
                  label="white_orchard_tavern_candleholder_small"
                  radius="4">
          <match mode="exact">candleholder_small_melted_fake_shadow_complex.w2ent</match>
        </override>

        <!-- Counter Candle - light cookie bleeds through counter -->
        <override tag_name="LR_WhiteOrchard_Tavern_Counter_Candle"
                  label="white_orchard_tavern_counter_candle">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.24" />
        </override>

        <!-- Rear table - light cookie bleeds through table -->
        <override tag_name="LR_3BL2s5qc_candle_small_group_melted_c_complex_2"
                  label="edited_candle_small_group_melted_c_complex_w2ent">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.21" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>