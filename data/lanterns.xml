<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Lantern defaults -->
      <overrides profile_name="Default"
                 weight="2">
        <!-- Lanterns -->
        <override tag_name="LR_Lantern"
                  label="lantern"
                  max_brightness="15"
                  min_radius="5"
                  attenuation="1">
          <any>
            <match>lamp_</match>
            <match>hanging_lamp_</match>
          </any>
          <!-- Reset point light to top of flame -->
          <offset x="0"
                  y="0"
                  z="-0.14" />
          <spotlight attenuation="1">
            <offset x="0"
                    y="0"
                    z="-0.14" />
          </spotlight>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>