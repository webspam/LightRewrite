<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Tir la Nia -->
      <overrides profile_name="Default"
                 weight="25">
        <override tag_name="LR_TirLaNia_Chandelier"
                  radius="10">
          <match mode="exact">chandelier_bright_noshadow.w2ent</match>
          <match type="layer"
                 mode="exact">levels\the_spiral\elven_city\light.w2l</match>
        </override>

        <!-- Stone braziers -->
        <override tag_name="LR_TirLaNia_StoneCampfire"
                  radius="8"
                  attenuation="0.8">
          <match mode="exact">campfire_01_no_meditation_no_loot.w2ent</match>
          <match type="layer"
                 mode="exact">levels\the_spiral\elven_city\bonfires.w2l</match>
        </override>

        <!-- Wall braziers -->
        <override tag_name="LR_TirLaNia_Brazier"
                  brightness="60"
                  radius="10"
                  attenuation="0.8">
          <match>braziers_wall_round</match>
          <match type="layer"
                 mode="exact">levels\the_spiral\elven_city\light.w2l</match>
        </override>

        <!-- Candles -->
        <override tag_name="LR_Edited_candle_small_group_melted_b_noshadow_w2ent"
                  brightness="16"
                  radius="6"
                  attenuation="0.9">
          <match mode="exact">candle_small_group_melted_b_noshadow.w2ent</match>
          <match type="layer"
                 mode="exact">levels\the_spiral\quests\q311_geels\aen_elle\objects\geels_objects.w2l</match>
        </override>
        <override tag_name="LR_Edited_candle_med_b_noshadow_w2ent"
                  brightness="16"
                  radius="6"
                  attenuation="0.9">
          <match mode="exact">candle_med_b_noshadow.w2ent</match>
          <match type="layer"
                 mode="exact">levels\the_spiral\quests\q311_geels\aen_elle\objects\geels_objects.w2l</match>
        </override>
        <override tag_name="LR_Edited_candle_large_group_caves_w2ent"
                  brightness="16"
                  radius="6"
                  attenuation="0.9">
          <match mode="exact">candle_large_group_caves.w2ent</match>
          <match type="layer"
                 mode="exact">levels\the_spiral\quests\q311_geels\aen_elle\objects\geels_objects.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>