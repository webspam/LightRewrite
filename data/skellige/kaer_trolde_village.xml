<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kaer Trolde - Village -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">levels\skellige\ard_skellig\kaer_trolde\village\</match>
        </matches>

        <!-- Chandelier Small -->
        <override tag_name="LR_KaerTrolde_Village_ChandelierSmall"
                  label="kaertrolde_village_chandeliersmall"
                  radius="5.5">
          <match mode="exact">chandelier_small.w2ent</match>
          <shadows casting_mode="Normal"
                   fade_distance="40"
                   fade_range="20" />
        </override>

        <!-- Wall Torch -->
        <override tag_name="LR_KaerTrolde_Village_TorchWall"
                  label="kaertrolde_village_torch_wall"
                  brightness="20">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <shadows fade_distance="30" />
        </override>

        <!-- Brazier -->
        <override tag_name="LR_KaerTrolde_Village_Brazier"
                  label="kaertrolde_village_brazier"
                  radius="6">
          <match mode="exact">braziers_floor_square_bounce.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="20" />
          <spotlight outerAngle="255.7" />
        </override>
      </overrides>

      <!-- Kaer Trolde - Village Interiors -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\village\decorations\lights.w2l</match>
        </matches>

        <!-- Fireplace -->
        <override tag_name="LR_KaerTrolde_Village_Fireplace"
                  label="kaertrolde_village_fireplace"
                  attenuation="1">
          <match mode="exact">fireplace_grate_complex.w2ent</match>
          <shadows fade_distance="10"
                   fade_range="7.5" />
        </override>

        <!-- Coal Firepit -->
        <override tag_name="LR_KaerTrolde_Village_CoalFirepit"
                  label="kaertrolde_village_coal_firepit"
                  brightness="50"
                  radius="3.5">
          <match mode="exact">coal_small_firepit_complex.w2ent</match>
          <shadows fade_distance="10" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>
      </overrides>


      <!-- Standing Torch - Exterior -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\village\decorations\fx.w2l</match>
        </matches>

        <override tag_name="LR_KaerTrolde_Village_TorchHandLongComplex"
                  label="kaertrolde_village_torch_hand_long_complex"
                  radius="5.5">
          <match mode="exact">torch_hand_long_complex.w2ent</match>
          <offset x="-0.076057"
                  y="0.0045"
                  z="0.63" />
        </override>
      </overrides>

    </light_rewrite>
  </custom>
</redxml>