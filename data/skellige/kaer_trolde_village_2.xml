<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kaer Trolde Village 2 -->
      <!-- TODO: Unfiltered, direct export - needs to be verified and cleaned up. -->
      <overrides profile_name="Default" weight="20">
        <!-- ?Inn fireplace -->
        <override tag_name="LR_KaerTroldeVillage2_CoalSmallFirepitComplex" brightness="70" radius="5">
          <match mode="exact">coal_small_firepit_complex.w2ent</match>
          <match type="layer" mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings_interior\lights.w2l</match>
          <shadows fade_distance="15" fade_range="10" />
          <offset x="0" y="0" z="0.11" />
          <spotlight brightness="50" radius="5" attenuation="1" innerAngle="155" outerAngle="195">
            <shadows casting_mode="OnlyDynamic" />
          </spotlight>
        </override>

        <!-- ?Inn candle group -->
        <override tag_name="LR_KaerTroldeVillage2_SmallCandleComplexC">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <match type="layer" mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings_interior\lights_interior_ns.w2l</match>
          <light index="1" radius="1.85">
            <shadows casting_mode="Normal" />
          </light>
          <light index="2">
            <shadows casting_mode="Normal" />
          </light>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>