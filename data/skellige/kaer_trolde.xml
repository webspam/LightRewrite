<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kaer Trolde Castle Path -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings\castle_path\footpath.w2l</match>
        </matches>

        <!-- Wall torch -->
        <override tag_name="LR_KaerTrolde_CastlePath_WallTorch"
                  label="kaer_trolde_castle_path_wall_torch"
                  brightness="20"
                  radius="6">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
        </override>

        <!-- Brazier - wall chain -->
        <override tag_name="LR_KaerTrolde_CastlePath_BrazierChain"
                  label="kaer_trolde_brazier_chain">
          <match mode="exact">braziers_wall_chain_bounce.w2ent</match>
          <shadows fade_range="15" />
        </override>

        <!-- Round Wall Brazier - Tunnel path -->
        <override tag_name="LR_Edited_braziers_wall_round_bounce_w2ent_2"
                  label="edited_braziers_wall_round_bounce_w2ent">
          <match mode="exact">braziers_wall_round_bounce.w2ent</match>
          <shadows fade_distance="40"
                   fade_range="20" />
          <offset x="-0.4485"
                  y="0"
                  z="1.24" />
          <colour r="255"
                  g="235"
                  b="215" />
        </override>
      </overrides>

      <!-- Kaer Trolde Castle -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\castle\gameplay.w2l</match>
        </matches>

        <!-- Round wall brazier -->
        <override tag_name="LR_KaerTrolde_BrazierRoundWall"
                  label="kaer_trolde_brazier_round_wall"
                  radius="8">
          <match mode="exact">braziers_wall_round_bounce.w2ent</match>
          <shadows fade_distance="25"
                   fade_range="20" />
          <offset x="-0.4485"
                  y="0"
                  z="1.24" />
          <colour r="255"
                  g="235"
                  b="215" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Wall torch -->
        <override tag_name="LR_KaerTrolde_WallTorch"
                  label="kaer_trolde_wall_torch"
                  brightness="20"
                  radius="5.5">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
        </override>

        <!-- Armoury Candle -->
        <override tag_name="LR_KaerTrolde_ArmouryCandle">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <!-- Interior LUM on all point lights -->
          <spotlight brightness="7.76"
                     radius="5"
                     attenuation="1">
            <offset x="-0.0555"
                    y="-0.0228"
                    z="0.31" />
          </spotlight>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>