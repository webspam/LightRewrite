<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Attack last camp -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">levels\skellige\ice_giant_island\q501_eredin_decoration\501_village\</match>
        </matches>

        <override tag_name="LR_FinalCamp_AllColours">
          <colour r="255"
                  g="250"
                  b="245" />
        </override>

        <!-- Storehouse braziers -->
        <override tag_name="LR_FinalCamp_Braziers_Floor_Square_Bounce_Dynamic"
                  brightness="80"
                  radius="7.5">
          <match mode="exact">braziers_floor_square_bounce_dynamic.w2ent</match>
          <shadows casting_mode="Normal"
                   fade_distance="10"
                   fade_range="10" />
          <offset x="0"
                  y="0"
                  z="0.88" />
          <spotlight brightness="30"
                     radius="3"
                     attenuation="1"
                     innerAngle="215"
                     outerAngle="290" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>