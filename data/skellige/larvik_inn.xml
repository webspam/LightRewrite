<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Larvik Inn -->
      <overrides profile_name="Default"
                 weight="25">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\hindarsfjall\larvik\buildings\larvik_inn\fx.w2l</match>
        </matches>

        <override tag_name="LR_LarvikInn_Shadow"
                  label="larvik_inn_shadow">
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>

        <!-- First firepit -->
        <override tag_name="LR_LarvikInn_CoalFirepit"
                  label="larvik_inn_coal_firepit"
                  radius="5.5">
          <match>coal_small</match>
          <shadows casting_mode="Normal" />
          <colour r="255"
                  g="245"
                  b="250" />
          <offset x="0"
                  y="0"
                  z="0.2" />
        </override>

        <!-- Second firepit -->
        <!-- <override tag_name="LR_LarvikInn_CoalFirepitNoShadow"
                  label="larvik_inn_coal_firepit_noshadow"
                  radius="5.5">
          <match mode="exact">coal_small_noshadow.w2ent</match>
          <offset x="0"
                  y="0"
                  z="0.2" />
        </override> -->

        <!-- Hanging lamp -->
        <override tag_name="LR_LarvikInn_HangingLampHolderComplex"
                  label="larvik_inn_hanging_lamp_holder_complex"
                  brightness="30"
                  radius="3"
                  attenuation="0.85">
          <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
          <colour r="255"
                  g="245"
                  b="235" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>


      </overrides>
    </light_rewrite>
  </custom>
</redxml>