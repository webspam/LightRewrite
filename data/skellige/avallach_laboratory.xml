<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <!-- levels\skellige\avallachs_cave\hidden_for_cs\deco.w2l -->
          <!-- levels\skellige\avallachs_cave\light_fx.w2l -->
          <match type="layer"
                 mode="startsWith">levels\skellige\avallachs_cave\</match>
        </matches>

        <!-- Shadows for all candelabra/candles -->
        <override tag_name="LR_AvallachLab_Shadows"
                  label="avallach_lab_shadows">
          <match mode="startsWith">cand</match>
          <shadows casting_mode="Normal"
                   fade_distance="25"
                   fade_range="15" />
        </override>

        <!-- Candle brightness -->
        <override tag_name="LR_AvallachLab_Shadows"
                  label="avallach_lab_shadows"
                  brightness="11">
          <any>
            <match mode="startsWith">candleholder_fancy</match>
          </any>

          <match mode="startsWith">cand</match>
          <shadows casting_mode="Normal"
                   fade_distance="25"
                   fade_range="15" />
        </override>

        <!-- Candelabra - Complex -->
        <override tag_name="LR_AvallachLab_Candelabra_Complex"
                  label="avallach_lab_candelabra_complex"
                  brightness="35"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <override tag_name="LR_AvallachLab_Chandelier_Bright_Noshadow"
                  label="avallach_lab_chandelier_bright_noshadow"
                  brightness="30"
                  radius="7.5">
          <match mode="exact">chandelier_bright_noshadow.w2ent</match>
        </override>
        <!-- Candelabra - Static Shadow -->
        <override tag_name="LR_AvallachLab_Candelabra_Static_Shadow"
                  label="avallach_lab_candelabra_static_shadow"
                  brightness="35"
                  radius="6"
                  attenuation="1">
          <match mode="exact">candelabra_static_shadow.w2ent</match>
        </override>

        <!-- Candleholder - Large Multi-Light -->
        <override tag_name="LR_AvallachLab_Candleholder_LargeMulti"
                  label="avallach_lab_candleholder_large_multi"
                  brightness="10"
                  rewriter_type="LRT_Candle">
          <match mode="exact">candle_holder_large_wood_a_complex.w2ent</match>
          <light index="0"
                 radius="5.5" />
          <light index="1"
                 radius="2.75" />
          <light index="2"
                 radius="2.75" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Candleholder - Large -->
        <override tag_name="LR_AvallachLab_Candleholder_Large"
                  label="avallach_lab_candleholder_large"
                  brightness="33"
                  radius="6"
                  attenuation="0.95">
          <match mode="exact">candle_holder_large_wood_a.w2ent</match>
          <offset x="0"
                  y="0"
                  z="2.14" />
        </override>

        <!-- Candles below tapestry -->
        <override tag_name="LR_AvallachLab_Candles_Below_Tapestry"
                  label="avallach_lab_candles_below_tapestry"
                  brightness="40"
                  radius="7.5">
          <match mode="exact">candle_large_group_caves.w2ent</match>
        </override>

        <!-- Bedroom Candelabra -->
        <override tag_name="LR_AvallachLab_TriCandleabra"
                  label="avallach_lab_tri_candleabra"
                  brightness="11">
          <match mode="exact">candelabra_tall_three_point_complex.w2ent</match>
          <spotlight brightness="15"
                     radius="2.5" />
        </override>

        <!-- Bedroom Standing Candleholder -->
        <override tag_name="LR_AvallachLab_Candleholder_Large_Noshadow"
                  label="avallach_lab_candleholder_large_noshadow"
                  brightness="20"
                  radius="6">
          <match mode="exact">candle_holder_large_wood_a_noshadow.w2ent</match>
          <offset x="0"
                  y="0"
                  z="2.05" />
        </override>

        <!-- candleholder_fancy.w2ent -->
        <!-- candleholder_fancy_complex.w2ent -->
        <!-- candleholder_fancy_noshadow.w2ent -->
      </overrides>
    </light_rewrite>
  </custom>
</redxml>