<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="startsWith">levels\skellige\ard_skellig\sk15_ragnar_village\</match>
        </matches>

        <!-- Standing torch -->
        <override tag_name="LR_Rogne_Standing_Torch"
                  label="rogne_standing_torch"
                  radius="6">
          <match mode="exact">torch_hand_long_complex.w2ent</match>
        </override>

        <!-- Wall torches -->
        <override tag_name="LR_Rogne_Wall_Torch_Wood"
                  label="rogne_wall_torch_wood"
                  brightness="20"
                  radius="7">
          <match mode="exact">torch_wall_wooden_small_bounce.w2ent</match>
        </override>
        <override tag_name="LR_Rogne_Wall_Torch"
                  label="rogne_wall_torch"
                  brightness="20"
                  radius="6">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
        </override>

        <!-- Lamp - standing -->
        <override tag_name="LR_Rogne_Lamp_Standing"
                  label="rogne_lamp_standing">
          <match mode="exact">lamp_standing_complex.w2ent</match>
          <offset x="0"
                  y="0"
                  z="-0.18" />
        </override>

        <!-- Chandelier -->
        <override tag_name="LR_Rogne_Chandelier_Small"
                  label="rogne_chandelier_small"
                  radius="6"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
          <shadows casting_mode="Normal"
                   fade_distance="10"
                   fade_range="7.5" />
        </override>

        <!-- Fireplace -->
        <override tag_name="LR_Rogne_Fireplace"
                  label="rogne_fireplace"
                  radius="6">
          <match mode="exact">coal_small.w2ent</match>
        </override>

        <!-- Candles -->
        <override tag_name="LR_Rogne_Candle_Small_Group_Melted_C"
                  label="edited_candle_small_group_melted_c_w2ent">
          <match mode="exact">candle_small_group_melted_c.w2ent</match>
          <light index="0"
                 radius="6" />
          <light index="1"
                 radius="2.75" />
          <light index="2"
                 radius="2.75" />
        </override>
        <override tag_name="LR_Rogne_Candle_Med_Melted"
                  label="rogne_candle_med_melted"
                  radius="8">
          <match mode="exact">candle_med_melted.w2ent</match>
        </override>

        <!-- Candle - back of house -->
        <override tag_name="LR_Rogne_Candle_Med_B"
                  label="rogne_candle_med_b"
                  brightness="4"
                  radius="6"
                  attenuation="0.5">
          <match mode="exact">candle_med_b.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>