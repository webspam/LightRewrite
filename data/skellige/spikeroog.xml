<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Spikeroog grouped overrides -->
      <overrides profile_name="Default"
                 weight="13">
        <!-- Udalryk's house candle shadows -->
        <override tag_name="LR_Spikeroog_CandleShadows"
                  label="spikeroog_candle_shadows">
          <match>candle</match>
          <match type="layer">levels\skellige\spikeroog\abandoned_house\</match>
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>
      </overrides>


      <!-- Spikeroog -->
      <overrides profile_name="Default"
                 weight="15">

        <!-- Candles -->
        <override tag_name="LR_SpikeroogInn_Candle"
                  label="spikeroog_inn_candle"
                  radius="4"
                  use_spotlight_colour="true">
          <any>
            <match>candle_small</match>
            <match>candle_med</match>
            <match>candleholder_small</match>
            <match>candleholder_med</match>
            <match>candlestick_small</match>
            <match>candleholder_fancy</match>
          </any>
          <match type="layer">levels\skellige\spikeroog\village_buildings\lights_interior.w2l</match>
        </override>

        <!-- Coal fireplace (pair) -->
        <override tag_name="LR_Spikeroog_CoalFireplace"
                  label="spikeroog_coal_fireplace"
                  brightness="50"
                  radius="7">
          <match mode="exact">coal_small.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_interior.w2l</match>
        </override>
        <override tag_name="LR_Spikeroog_CoalSmallNoshadow"
                  label="spikeroog_coal_small_noshadow"
                  brightness="5.5"
                  radius="5.5"
                  attenuation="1">
          <match mode="exact">coal_small_noshadow.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_interior.w2l</match>
        </override>

        <!-- Exterior torches -->
        <override tag_name="LR_Spikeroog_WoodenWallTorches"
                  label="spikeroog_wooden_wall_torches"
                  brightness="30"
                  radius="5">
          <match mode="exact">torch_wall_wooden_small_bounce.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\an_skellig\warriors_village\house_big_porch\lights.w2l</match>
        </override>
        <override tag_name="LR_Spikeroog_MetalWallTorches"
                  label="spikeroog_metal_wall_torches"
                  brightness="20"
                  radius="5">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_exterior.w2l</match>
          <shadows fade_distance="20" />
        </override>

        <!-- Standing torches -->
        <override tag_name="LR_Spikeroog_StandingTorches"
                  label="spikeroog_standing_torches"
                  radius="7.5">
          <match mode="exact">torch_hand_long_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_exterior.w2l</match>
          <shadows fade_distance="20"
                   fade_range="15" />
          <offset x="0"
                  y="0"
                  z="0.7" />
        </override>
        <override tag_name="LR_Spikeroog_TorchHandLong"
                  label="spikeroog_torch_hand_long"
                  brightness="30"
                  radius="6">
          <match mode="exact">torch_hand_long.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_exterior.w2l</match>
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>

        <!-- Standing candleholder -->
        <override tag_name="LR_Spikeroog_StandingCandleHolder"
                  label="spikeroog_standing_candle_holder"
                  brightness="14"
                  radius="6"
                  attenuation="0.9">
          <match>candle_holder_large_wood</match>
          <match type="layer">levels\skellige\spikeroog\</match>
          <shadows fade_distance="20"
                   fade_range="15" />
          <offset x="0"
                  y="0"
                  z="2.1" />
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_Spikeroog_Candelabra"
                  label="spikeroog_candelabra"
                  brightness="14"
                  radius="6"
                  attenuation="0.9">
          <match mode="exact">candelabra.w2ent</match>
          <match type="layer">levels\skellige\spikeroog\</match>
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>

        <!-- Inn chandelier -->
        <override tag_name="LR_Spikeroog_ChandelierSmallNoshadow"
                  label="spikeroog_chandelier_small_noshadow"
                  radius="6.5"
                  attenuation="0.9"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_interior.w2l</match>
          <shadows casting_mode="Normal"
                   fade_distance="15"
                   fade_range="20" />
          <offset x="0"
                  y="0"
                  z="0.35" />
        </override>

        <!-- Fireplace (coal firepit) -->
        <override tag_name="LR_Spikeroog_Fireplace"
                  label="spikeroog_fireplace">
          <match mode="exact">coal_small_firepit_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\spikeroog\village_buildings\lights_interior.w2l</match>
          <colour r="255"
                  g="255"
                  b="255" />
          <offset x="0"
                  y="0"
                  z="0.2" />
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>