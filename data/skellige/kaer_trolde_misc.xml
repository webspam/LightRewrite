<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_Edited_braziers_floor_square_bounce_dynamic_w2ent_3">
          <match mode="exact">braziers_floor_square_bounce_dynamic.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\q210_avallach_ship\fx.w2l</match>
          <shadows casting_mode="Normal"
                   fade_distance="40"
                   fade_range="20" />
        </override>

        <override tag_name="LR_Edited_braziers_floor_square_bounce_dynamic_w2ent_4">
          <match mode="exact">braziers_floor_square_bounce_dynamic.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\quests\q201_pirates\feast\entities\q201_cs_brazzier.w2l</match>
          <shadows casting_mode="Normal"
                   fade_distance="40"
                   fade_range="20" />
        </override>

        <!-- Kaer Trolde Painter House -->
        <override tag_name="LR_KaerTrolde_Painter_Candle"
                  force_single_light="true">
          <match>candle</match>
          <match type="layer"
                 mode="endsWith">\sq208_painter_interior.w2l</match>
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>