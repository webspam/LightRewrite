<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <!-- levels\skellige\ard_skellig\snowgiants_arm\lugos_tower\house_interior_ns.w2l -->
          <!-- levels\skellige\ard_skellig\snowgiants_arm\lugos_tower\light_fx.w2l -->
          <!-- levels\skellige\ard_skellig\snowgiants_arm\lugos_tower\gameplay.w2l -->
          <match type="layer"
                 mode="startsWith">levels\skellige\ard_skellig\snowgiants_arm\lugos_tower\</match>
        </matches>

        <!-- Candleholder -->
        <override tag_name="LR_Lugos_Candleholder"
                  radius="6">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <!-- Fireplace -->
        <override tag_name="LR_Lugos_Fireplace"
                  radius="6"
                  attenuation="0.9">
          <match mode="exact">fireplace_grate.w2ent</match>
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>

        <!-- Campfire -->
        <override tag_name="LR_Lugos_Campfire"
                  radius="5.5"
                  attenuation="0.85">
          <match mode="exact">campfire_01.w2ent</match>
        </override>

        <!-- Campfire Large -->
        <override tag_name="LR_Lugos_Campfire_Cave"
                  radius="7.5">
          <match mode="exact">campfire_01_cave.w2ent</match>
        </override>
      </overrides>

      <!-- One larger fireplace -->
      <overrides profile_name="Default"
                 weight="21">
        <!-- Override above fireplace -->
        <override tag_name="LR_Lugos_Fireplace_Large"
                  radius="7.5"
                  attenuation="1">
          <match mode="exact">fireplace_grate.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\snowgiants_arm\lugos_tower\gameplay.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>