<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kaer Trolde Inn - Quick fixes for flicker -->
      <!-- TODO: Fine-tune, label properly -->
      <overrides profile_name="Default"
                 weight="20">
        <override tag_name="LR_KaerTrolde_Village_SmallCandleComplexC"
                  label="kaer_trolde_village_small_candle_complex_c">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\village\decorations\fx.w2l</match>
          <light index="1"
                 radius="2" />
          <light index="2"
                 radius="2" />
        </override>

        <override tag_name="LR_KaerTrolde_Village_FireplaceGrateComplex"
                  label="kaer_trolde_village_fireplace_grate_complex"
                  brightness="60"
                  radius="7"
                  attenuation="1">
          <match mode="exact">fireplace_grate_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings\building_a\lights.w2l</match>
          <colour r="255"
                  g="250"
                  b="245" />
          <fire_fx_offset x="0"
                          y="0"
                          z="0" />
          <spotlight brightness="39.61"
                     attenuation="0.94">
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <override tag_name="LR_KaerTrolde_Village_Chandelier"
                  label="kaer_trolde_village_chandelier">
          <match mode="exact">chandelier.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings_interior\building_meshes.w2l</match>
          <light index="0"
                 attenuation="1"
                 brightness="11" />
          <light index="1"
                 brightness="11">
            <shadows casting_mode="None" />
          </light>
          <light index="2"
                 brightness="11">
            <shadows casting_mode="None" />
          </light>
          <light index="3"
                 brightness="11">
            <shadows casting_mode="None" />
          </light>
        </override>

        <!-- Shjy..oosta? -->
        <override tag_name="LR_KaerTrolde_Village_SmallCandleComplexC_3"
                  label="kaer_trolde_village_small_candle_complex_c_3">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\q201_tailor_seller\lights.w2l</match>
          <light index="1"
                 radius="2">
            <shadows casting_mode="Normal" />
          </light>
          <light index="2"
                 radius="2">
            <shadows casting_mode="Normal" />
          </light>
        </override>

        <override tag_name="LR_KaerTrolde_Village_CoalSmallFirepitComplex"
                  label="kaer_trolde_village_coal_small_firepit_complex"
                  brightness="70"
                  radius="7.5"
                  attenuation="1">
          <match mode="exact">coal_small_firepit_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings_interior\lights_interior_ns.w2l</match>
        </override>
      </overrides>


      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings_interior\lights.w2l</match>
        </matches>
        <override tag_name="LR_KaerTrolde_Village_SmallCandleComplexC_2"
                  label="kaer_trolde_village_small_candle_complex_c_2">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <light index="1"
                 radius="1">
            <shadows casting_mode="Normal" />
          </light>
          <light index="2"
                 radius="1">
            <shadows casting_mode="Normal" />
          </light>
        </override>
        <override tag_name="LR_KaerTrolde_Village_SmallCandleComplexB"
                  label="kaer_trolde_village_small_candle_complex_b"
                  brightness="12">
          <match mode="exact">candle_small_group_melted_b_complex.w2ent</match>
        </override>
        <override tag_name="LR_KaerTrolde_Village_SmallCandleComplexD"
                  label="kaer_trolde_village_small_candle_complex_d">
          <match mode="exact">candle_small_group_melted_d_complex.w2ent</match>
          <light index="1"
                 radius="1.5" />
        </override>
      </overrides>


      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\buildings_interior\yennifers_room\fx.w2l</match>
        </matches>
        <override tag_name="LR_KaerTrolde_YennifersRoom_CandleHolderLargeWoodBComplex"
                  label="kaer_trolde_yennifers_room_candle_holder_large_wood_b_complex"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
        </override>
        <override tag_name="LR_KaerTrolde_YennifersRoom_CandelabraComplex"
                  label="kaer_trolde_yennifers_room_candelabra_complex"
                  radius="3.75"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>