<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Larvik -->
      <overrides profile_name="Default"
                 weight="15">
        <matches>
          <match type="layer">levels\skellige\hindarsfjall\larvik\</match>
        </matches>

        <!-- Candle holder -->
        <override tag_name="LR_Larvik_LargeCandleHolder"
                  brightness="24"
                  radius="4"
                  attenuation="0.9">
          <match mode="exact">candle_holder_large_wood_c.w2ent</match>
          <shadows fade_distance="15"
                   fade_range="12.5" />
        </override>

        <!-- Candles -->
        <override tag_name="LR_Larvik_MedMeltedCandle">
          <match mode="exact">candle_med_melted.w2ent</match>
          <shadows fade_distance="15" />
        </override>

        <!-- Iron chandelier -->
        <override tag_name="LR_Larvik_IronChandelier"
                  radius="6.5"
                  attenuation="0.9"
                  force_cast_shadows="true">
          <match mode="exact">chandelier_small.w2ent</match>
          <shadows casting_mode="Normal"
                   fade_distance="15"
                   fade_range="20" />
          <offset x="0"
                  y="0"
                  z="0.35" />
        </override>

        <!-- Coal firepits -->
        <override tag_name="LR_Larvik_CoalSmallFirepitComplex">
          <match mode="exact">coal_small_firepit_complex.w2ent</match>
          <shadows fade_distance="10"
                   fade_range="7.5" />
        </override>

        <override tag_name="LR_Larvik_CoalSmall"
                  radius="6">
          <match mode="exact">coal_small.w2ent</match>
          <!-- Anything higher than 0.15, and the light shines through the pots hanging over the coals -->
          <offset x="0"
                  y="0"
                  z="0.15" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>