<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Kaer Trolde - Castle Interior -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\castle_interior\lights_fx.w2l</match>
        </matches>

        <!-- Fancy Small Candleholder -->
        <override tag_name="LR_KaerTrolde_CandleholderFancyComplex"
                  label="kaer_trolde_candleholder_fancy_complex"
                  radius="6">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <!-- Candle Group - small, group of 2 -->
        <override tag_name="LR_KaerTrolde_CandleSmallGroupMeltedDComplex"
                  label="kaer_trolde_candle_small_group_melted_d_complex"
                  brightness="8">
          <match mode="exact">candle_small_group_melted_d_complex.w2ent</match>
          <light index="0"
                 radius="7.5" />
          <light index="1"
                 radius="3" />
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_KaerTrolde_CandleabraComplex"
                  label="kaer_trolde_candleabra_complex"
                  brightness="10.23"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <shadows fade_distance="20"
                   fade_range="15" />
          <offset x="0"
                  y="0"
                  z="0.85" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Standing Candleholder - large, row of candles -->
        <override tag_name="LR_KaerTrolde_CandleHolderLarge"
                  label="kaer_trolde_candle_holder_large"
                  radius="5">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
        </override>

        <!-- Standing Candelabra -->
        <override tag_name="LR_KaerTrolde_CandleabraStanding"
                  label="kaer_trolde_candleabra_standing"
                  radius="5">
          <match mode="exact">candelabra_standing_complex.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="20" />
          <offset x="0"
                  y="0"
                  z="2.06" />
          <spotlight brightness="7"
                     radius="3.5" />
        </override>

        <!-- Fireplaces -->
        <override tag_name="LR_KaerTrolde_Fireplace"
                  label="kaer_trolde_fireplace"
                  radius="7">
          <match mode="exact">fireplace_grate.w2ent</match>
          <shadows fade_distance="30"
                   fade_range="20" />
        </override>

        <!-- Fireplace near smithing area -->
        <override tag_name="LR_KaerTrolde_SmithingFireplace"
                  label="kaer_trolde_smithing_fireplace"
                  brightness="70"
                  radius="7.5"
                  attenuation="0.9">
          <match mode="exact">campfire_02_cave.w2ent</match>
          <shadows fade_distance="20"
                   fade_range="15" />
        </override>

        <!-- Wall torch -->
        <override tag_name="LR_KaerTrolde_Interior_WallTorch"
                  label="kaer_trolde_wall_torch"
                  brightness="20"
                  radius="7"
                  attenuation="1">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
          <shadows fade_distance="40" />
          <colour r="255"
                  g="245"
                  b="240" />
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>