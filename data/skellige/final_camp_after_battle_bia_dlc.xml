<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Increase range / shadows on some lights added by BiA -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">dlc\dlcbia\levels\skellige\q502_nilfgaard_camp\lodge_tent_static.w2l</match>
        </matches>
        <override tag_name="LR_Edited_candelabra_tall_three_point_noshadow_w2ent"
                  brightness="24"
                  radius="5">
          <match mode="exact">candelabra_tall_three_point_noshadow.w2ent</match>
          <shadows casting_mode="Normal"
                   fade_distance="30"
                   fade_range="20" />
        </override>

        <override tag_name="LR_Edited_chandelier_bright_noshadow_w2ent"
                  brightness="35"
                  radius="7.5">
          <match mode="exact">chandelier_bright_noshadow.w2ent</match>
          <shadows casting_mode="Normal" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>