<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Skellige -->
      <overrides profile_name="Default"
                 weight="10">
        <matches>
          <match type="layer">levels\skellige\</match>
        </matches>

        <!-- Candles -->
        <override tag_name="LR_Skellige_Candle"
                  label="skellige_candle"
                  radius="5"
                  use_spotlight_colour="true">
          <any>
            <match>candle_small</match>
            <match>candle_med</match>
            <match>candle_tall</match>
            <match>candleholder_small</match>
            <match>candleholder_med</match>
            <match>candleholder_fancy</match>
            <match>candlestick_small</match>
            <match>baron_candle</match>
            <match>candle_jar</match>
            <match>candle_shelf</match>
          </any>
        </override>

        <!-- Lamp - Standing -->
        <override tag_name="LR_Skellige_LampStanding"
                  label="skellige_lamp_standing"
                  brightness="15"
                  radius="5"
                  attenuation="1">
          <any>
            <match mode="exact">hanging_lamp_holder_complex.w2ent</match>
            <match mode="exact">lamp_standing_complex.w2ent</match>
          </any>
          <spotlight radius="0" />
        </override>
      </overrides>


      <!-- Skellige fine-tuned entities -->
      <overrides profile_name="Default"
                 weight="15">
        <matches>
          <match type="layer">levels\skellige\</match>
        </matches>

        <!-- Horn chandelier -->
        <override tag_name="LR_Skellige_HornChandelier"
                  label="skellige_horn_chandelier"
                  brightness="20"
                  radius="8"
                  attenuation="0.9">
          <match mode="exact">horn_chandelier.w2ent</match>
          <shadows fade_distance="40"
                   fade_range="20" />
        </override>

        <!-- Tri-candelabra - standing -->
        <override tag_name="LR_KaerTrolde_TriCandleabra"
                  label="kaer_trolde_tri_candleabra"
                  brightness="8"
                  rewriter_type="LRT_Candle">
          <match>candelabra_tall_three_point</match>
          <light index="0"
                 brightness="12"
                 radius="6" />
          <light index="1"
                 radius="2.75" />
          <light index="2"
                 radius="2.75" />

          <spotlight radius="0" />
          <shadows fade_distance="30"
                   fade_range="20" />
        </override>

        <!-- Candle holder large wood c -->
        <override tag_name="LR_Skellige_CandleHolderLargeWoodC"
                  label="skellige_candle_holder_large_wood_c"
                  brightness="13"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candle_holder_large_wood_c.w2ent</match>
        </override>

        <!-- Campfire -->
        <override tag_name="LR_Skellige_Campfire01"
                  label="skellige_campfire_01"
                  brightness="50"
                  radius="5.5"
                  attenuation="0.9">
          <match>campfire_01</match>
        </override>

        <!-- Cauldron -->
        <override tag_name="LR_Skellige_Cauldron"
                  label="skellige_cauldron"
                  radius="5.5">
          <match mode="exact">stand_mw_cooking_big_cauldron_ap.w2ent</match>
        </override>

        <!-- Forge -->
        <override tag_name="LR_aN4rPuRI_ob_forge_px"
                  label="edited_ob_forge_px"
                  radius="5">
          <match mode="exact">ob_forge_px.w2ent</match>
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>