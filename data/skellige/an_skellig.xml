                  label="an_skellig_torch_wall_wooden">
          <match mode="exact">torch_wall_wooden_small_bounce.w2ent</match>
          <match type="layer">levels\skellige\an_skellig\</match>
          <shadows fade_distance="30"
                   fade_range="20" />
        </override>
      </overrides>

    </light_rewrite>
  </custom>
</redxml>