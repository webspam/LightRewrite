<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- HoS - Herbalist -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <any>
            <match type="layer">levels\novigrad\white_bridge\herbalist\</match>
            <match type="layer"
                   mode="exact">dlc\ep1\levels\novigrad\locations\q603\cellar_plan.w2l</match>
          </any>
        </matches>

        <!-- Torch Wall Wooden -->
        <override tag_name="LR_HosHerbalist_TorchWallWooden"
                  label="hos_herbalist_torch_wall_wooden"
                  brightness="20">
          <match mode="exact">torch_wall_wooden_complex.w2ent</match>
        </override>

        <!-- Torch on a Stick -->
        <override tag_name="LR_HosHerbalist_TorchOnAStick"
                  label="hos_herbalist_torch_on_a_stick"
                  brightness="19.93"
                  radius="4.5">
          <match mode="exact">torch_hand_long_complex.w2ent</match>
          <shadows fade_range="20" />
          <colour r="255"
                  g="250"
                  b="245" />
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <!-- Candle - Med B -->
        <override tag_name="LR_HosHerbalist_CandleMedB"
                  label="hos_herbalist_candle_med_b"
                  radius="5">
          <match mode="exact">candle_med_b.w2ent</match>
        </override>

        <!-- Candle - Med Melted No Shadow -->
        <override tag_name="LR_HosHerbalist_CandleMedMelted"
                  label="hos_herbalist_candle_med_melted"
                  brightness="5"
                  radius="5"
                  attenuation="1">
          <match mode="exact">q603_candle_med_melted_noshadow_.w2ent</match>
        </override>

        <!-- Candelabra - Tall Three Point -->
        <override tag_name="LR_HosHerbalist_CandelabraTallThreePoint"
                  label="hos_herbalist_candelabra_tall_three_point"
                  brightness="5"
                  attenuation="1">
          <match mode="exact">candelabra_tall_three_point.w2ent</match>
          <light index="0"
                 radius="5" />
          <light index="1"
                 radius="3.5" />
          <light index="2"
                 radius="3.5" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>