<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Dandelion's -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <match type="layer">levels\novigrad\novigrad\dandelion_brothel\veryrich\</match>
        </matches>

        <!-- Staircase candles -->
        <override tag_name="LR_Chameleon_Staircase_Candle"
                  label="chameleon_staircase_candle"
                  attenuation="0.95">
          <match mode="exact">candle_shelf_complex.w2ent</match>
          <shadows fade_distance="10"
                   fade_range="7.5"
                   blend_factor="1" />
          <!-- Top of candle flame -->
          <fire_fx_offset x="0"
                          y="0"
                          z="0.12" />
        </override>

        <!-- Staircase on railing -->
        <override tag_name="LR_Chameleon_Staircase_Railing_Candle"
                  label="chameleon_staircase_railing_candle"
                  brightness="5">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\dandelion_brothel\veryrich\interior\lights.w2l</match>
          <shadows fade_distance="10"
                   fade_range="7.5"
                   blend_factor="1" />
          <!-- Top of candle flame -->
          <fire_fx_offset x="0"
                          y="0"
                          z="0.12" />
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_Chameleon_Candelabra"
                  label="chameleon_candelabra_complex"
                  brightness="6"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\dandelion_brothel\veryrich\interior\lights.w2l</match>
          <spotlight brightness="5"
                     radius="7.5"
                     attenuation="0.85">
            <offset x="0"
                    y="0"
                    z="0.35" />
          </spotlight>
          <!-- Middle candle flame -->
          <offset x="0"
                  y="0"
                  z="0.75" />
          <colour r="255"
                  g="250"
                  b="245" />
        </override>

        <!-- Candelabra on a stick -->
        <override tag_name="LR_Chameleon_Candelabra_Standing"
                  label="chameleon_candelabra_standing"
                  brightness="6"
                  radius="7"
                  attenuation="1">
          <match mode="exact">candelabra_standing_complex.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\dandelion_brothel\veryrich\interior\lights.w2l</match>
          <offset x="0"
                  y="0"
                  z="1.95" />
          <colour r="255"
                  g="250"
                  b="245" />
          <spotlight brightness="5"
                     attenuation="0.8" />
        </override>

        <!-- Hanging red lantern -->
        <override tag_name="LR_Chameleon_Hanging_Lantern_Red"
                  label="chameleon_hanging_lantern_red"
                  brightness="25"
                  radius="6.5"
                  attenuation="1">
          <match mode="exact">hanging_lantern_red.w2ent</match>
          <!-- Centre of the lantern -->
          <offset x="0"
                  y="0"
                  z="-1.08" />
          <shadows fade_distance="50"
                   fade_range="10"
                   blend_factor="1" />
        </override>
        <!-- Hanging red lantern - interior only -->
        <override tag_name="LR_Chameleon_Hanging_Lantern_Red_Interior"
                  label="chameleon_hanging_lantern_red_interior"
                  radius="5">
          <match mode="exact">hanging_lantern_red.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\dandelion_brothel\veryrich\interior\lights.w2l</match>
        </override>

        <!-- Horn chandelier -->
        <override tag_name="LR_Chameleon_Horn_Chandelier"
                  label="chameleon_horn_chandelier"
                  brightness="30"
                  attenuation="1">
          <match mode="exact">horn_chandelier.w2ent</match>
          <offset x="0"
                  y="0"
                  z="-0.85" />
        </override>

      </overrides>
    </light_rewrite>
  </custom>
</redxml>