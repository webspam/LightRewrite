<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Global defaults - overwrites everything -->
      <overrides profile_name="Default"
                 weight="0">
        <!-- Candles -->
        <override tag_name="LR_Candle"
                  label="candle"
                  brightness="5"
                  radius="4"
                  attenuation="1"
                  min_auto_hide_distance="100"
                  min_auto_hide_range="100"
                  rewriter_type="LRT_Candle">
          <any>
            <match>candle_small</match>
            <match>candle_med</match>
            <match>candle_tall</match>
            <match>candleholder_small</match>
            <match>candleholder_med</match>
            <match>candleholder_fancy</match>
            <match>candlestick_small</match>
            <match>baron_candle</match>
            <match>candle_jar</match>
            <match>candle_shelf</match>
          </any>
          <shadows min_fade_distance="10"
                   min_fade_range="7.5"
                   blend_factor="1" />
          <fire_fx_offset x="0"
                          y="0"
                          z="0.12" />
        </override>

        <!-- Small Group B - Complex -->
        <!-- Two flames on one point light, brightness calculated as Base=5, coefficient=0.4: 5 * 2^0.4 = 6.6 -->
        <override tag_name="LR_candle_small_group_melted_b_complex"
                  label="candle_small_group_melted_b_complex"
                  brightness="6.6">
          <match mode="exact">candle_small_group_melted_b_complex.w2ent</match>
        </override>

        <!-- Torches -->
        <!-- <override tag_name="LR_Torch"
                  label="torch"
                  brightness="30"
                  radius="10"
                  attenuation="1.0">
          <match>torch</match>
          <shadows fade_distance="15"
                   fade_range="7.5"
                   blend_factor="1" />
        </override> -->

        <!-- Braziers -->
        <!-- <override tag_name="LR_Brazier"
                  label="brazier"
                  brightness="40"
                  radius="10"
                  attenuation="1.0">
          <match>brazier</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override> -->

        <!-- Candelabras -->
        <!-- <override tag_name="LR_Candelabra"
                  label="candelabra"
                  brightness="8"
                  radius="10"
                  attenuation="1.0">
          <any>
            <match>gen_rich_candleholder_b</match>
            <match>candelabra</match>
          </any>
          <shadows fade_distance="15"
                   fade_range="7.5"
                   blend_factor="1" />
        </override> -->

        <!-- Campfires -->
        <!-- <override tag_name="LR_Campfire"
                  label="campfire"
                  brightness="50"
                  radius="12"
                  attenuation="0.85">
          <match>campfire</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override> -->

        <!-- Chandeliers -->
        <!-- <override tag_name="LR_Chandelier"
                  label="chandelier"
                  brightness="12"
                  radius="18"
                  attenuation="1.0">
          <match>chandelier</match>
          <shadows fade_distance="20"
                   fade_range="10"
                   blend_factor="1" />
        </override> -->

        <!-- Auto Hide -->

        <!-- Candelabras & Candle Holders -->
        <override tag_name="LR_AutoHide_CandleMedium"
                  min_auto_hide_distance="15">
          <any>
            <match>candle_holder</match>
            <match>gen_rich_candleholder_b</match>
            <match>candle_large_group_caves</match>
            <match mode="contains">candelabra</match>
          </any>
        </override>

        <!-- Lanterns -->
        <override tag_name="LR_AutoHide_Lantern"
                  min_auto_hide_distance="30">
          <any>
            <match mode="contains">lantern</match>
            <match mode="contains">lamp</match>
          </any>
        </override>

        <!-- Open fires -->
        <override tag_name="LR_AutoHide_OpenFire"
                  min_auto_hide_distance="100">
          <any>
            <match>fireplace</match>
            <match>gen_rich_fireplace</match>
            <match>coal</match>
            <match>bonfire</match>
            <match mode="contains">campfire</match>
          </any>
        </override>

        <!-- Chandeliers -->
        <override tag_name="LR_AutoHide_Chandelier"
                  min_auto_hide_distance="50">
          <match mode="contains">chandelier</match>
        </override>

        <!-- Braziers -->
        <override tag_name="LR_AutoHide_Brazier"
                  min_auto_hide_distance="500">
          <match mode="contains">brazier</match>
          <spotlight min_auto_hide_distance="500" />
        </override>

        <!-- Eternal Fire Shrines -->
        <override tag_name="LR_AutoHide_EternalFire"
                  min_auto_hide_distance="500">
          <match>shrine_</match>
          <spotlight min_auto_hide_distance="500" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>