<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Novigrad Bathhouse -->
      <overrides profile_name="Default"
                 weight="20">
        <matches>
          <any>
            <match type="layer">levels\novigrad\env_global_pbr\env_novigrad\env_bathhouse_nn\</match>
            <match type="layer">levels\novigrad\novigrad\bathhouse\</match>
          </any>
        </matches>

        <!-- Candelabra -->
        <override tag_name="LR_Bathhouse_Candelabra"
                  label="bathhouse_candelabra"
                  brightness="8"
                  radius="4"
                  attenuation="1">
          <match mode="exact">candelabra_tall_three_point.w2ent</match>
        </override>

        <!-- Candelabra NoShadow -->
        <override tag_name="LR_Bathhouse_Candelabra_NoShadow"
                  label="bathhouse_candelabra_no_shadow"
                  brightness="8"
                  radius="4.5"
                  attenuation="1">
          <match mode="exact">candelabra_tall_three_point_noshadow.w2ent</match>
        </override>

        <!-- Candelabra Standing -->
        <override tag_name="LR_Bathhouse_Candelabra_Standing"
                  label="bathhouse_candelabra_standing"
                  brightness="9.52"
                  radius="5"
                  attenuation="1">
          <match mode="exact">candelabra_standing_complex.w2ent</match>
          <shadows fade_distance="15"
                   fade_range="14"
                   blend_factor="0.8" />
          <colour r="255"
                  g="250"
                  b="245" />
          <offset x="0"
                  y="0"
                  z="1.96" />
          <spotlight radius="0" />
        </override>

        <!-- Floor Brazier -->
        <override tag_name="LR_Bathhouse_Floor_Brazier"
                  label="bathhouse_floor_brazier"
                  brightness="20"
                  radius="6.5"
                  attenuation="1">
          <match mode="exact">bathhouse_floor_brazier_complex.w2ent</match>
          <shadows fade_distance="7.5"
                   fade_range="20" />
          <offset x="0"
                  y="0"
                  z="0.87" />
          <spotlight brightness="20"
                     radius="6.5"
                     innerAngle="255"
                     outerAngle="305">
            <offset x="0"
                    y="0"
                    z="0.87" />
          </spotlight>
        </override>

        <!-- Chandelier -->
        <override tag_name="LR_Bathhouse_Chandelier"
                  label="bathhouse_chandelier"
                  brightness="20"
                  radius="5"
                  attenuation="1">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
          <!-- dijkstras_office.w2l -->
          <shadows fade_distance="20"
                   fade_range="20" />
          <offset x="0"
                  y="0"
                  z="0.27" />
        </override>

        <!-- Torches -->
        <override tag_name="LR_Edited_torch_wall_metal_w2ent"
                  label="edited_torch_wall_metal_w2ent"
                  brightness="20"
                  radius="5"
                  attenuation="0.9">
          <match mode="exact">torch_wall_metal.w2ent</match>          <!-- Top of flame -->
          <offset x="-0.4"
                  y="0"
                  z="0.6" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>