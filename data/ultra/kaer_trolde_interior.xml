<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Ultra: Kaer Trolde - Interior -->
      <overrides profile_name="Ultra"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\castle_interior\lights_fx.w2l</match>
        </matches>
        <override tag_name="LR_Ultra_KaerTrolde_MainHall_chandelier_bright_noshadow"
                  brightness="30">
          <match mode="exact">chandelier_bright_noshadow.w2ent</match>
        </override>

        <override tag_name="LR_Ultra_KaerTrolde_MainHall_torch_wall_metal_bounce"
                  attenuation="1">
          <match mode="exact">torch_wall_metal_bounce.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>