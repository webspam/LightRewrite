<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Ultra: Kingfisher - PT & RT Shadows Only -->
      <overrides profile_name="Ultra"
                 weight="22">
        <transport>pt, rtshadows</transport>
        <matches>
          <match type="layer">levels\novigrad\novigrad\zimorodek_inn\</match>
        </matches>

        <!-- Default the other lights to on -->
        <override tag_name="LR_Ultra_Kingfisher_CandleHolderFancy"
                  radius="5.5"
                  brightness="2"
                  attenuation="1"
                  default_state="on">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
          <match type="layer">levels\novigrad\novigrad\zimorodek_inn\</match>
        </override>

        <!-- Bar, Barrel -->
        <override tag_name="LR_Ultra_Kingfisher_CandleGroupC">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <light index="1"
                 brightness="2"
                 radius="6.75" />
        </override>

        <!-- Stage -->
        <override tag_name="LR_Ultra_Kingfisher_LargeCandleHolderB"
                  brightness="3"
                  radius="6.5">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
        </override>

        <!-- Candelabra -->
        <override tag_name="LR_UltraPT_Kingfisher_CandelabraComplex"
                  rewriter_type="LRT_FxAlign">
          <any>
            <match>candelabra_complex</match>
            <match mode="exact">candelabra.w2ent</match>
          </any>
          <lum exclude_scene="true" />
          <spotlight brightness="10.23"
                     radius="5"
                     attenuation="1"
                     innerAngle="268"
                     outerAngle="350"
                     softness="0.45">
            <colour r="255"
                    g="250"
                    b="245" />
            <lum exclude_scene="false" />
          </spotlight>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.07" />
        </override>

        <override tag_name="LR_UltraPT_Kingfisher_CandleHolderFancy"
                  rewriter_type="LRT_FxAlign">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
          <lum exclude_scene="true" />
          <spotlight brightness="2"
                     min_radius="3.5"
                     attenuation="1"
                     innerAngle="255"
                     outerAngle="330"
                     softness="0.8">
            <lum exclude_scene="false" />
            <colour r="255"
                    g="250"
                    b="245" />
          </spotlight>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.07" />
        </override>

        <override tag_name="LR_Ultra_Kingfisher_CandelabraStanding"
                  radius="5.5"
                  brightness="9.52"
                  rewriter_type="LRT_FxAlign">
          <match mode="exact">candelabra_standing.w2ent</match>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.07" />
        </override>

        <!-- Candelabra on a Stick - Penthouse -->
        <override tag_name="LR_UltraPT_Kingfisher_Penthouse_CandleabraOnAStick"
                  rewriter_type="LRT_FxAlign">
          <match mode="exact">candelabra_standing_complex.w2ent</match>
          <!-- building\lights.w2l -->
          <lum exclude_scene="true" />

          <spotlight brightness="9.52"
                     radius="5.5"
                     attenuation="1"
                     innerAngle="280"
                     outerAngle="342.5">
            <lum exclude_scene="false" />
            <colour r="255"
                    g="250"
                    b="245" />
          </spotlight>
          <fire_fx_offset x="0"
                          y="0"
                          z="0.07" />
        </override>
      </overrides>

      <!-- Kingfisher Inn - First floor, Northeast Room (3) -->
      <overrides profile_name="Ultra"
                 weight="22">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\zimorodek_inn\building\northeast_room_q310\lights.w2l</match>
        </matches>
        <override tag_name="LR_UltraPT_Kingfisher3_candleholder_fancy_complex_2">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
          <spotlight radius="3.5" />
        </override>

        <override tag_name="LR_UltraPT_Kingfisher3_candle_small_group_melted_d_complex">
          <match mode="exact">candle_small_group_melted_d_complex.w2ent</match>
          <light index="0"
                 brightness="2" />
          <light index="1"
                 brightness="2"
                 radius="3" />
        </override>

        <override tag_name="LR_UltraPT_Kingfisher3_candle_small_group_melted_complex">
          <match mode="exact">candle_small_group_melted_complex.w2ent</match>
          <light index="0"
                 brightness="2" />
          <light index="1"
                 brightness="2"
                 radius="3" />
        </override>

        <override tag_name="LR_UltraPT_Kingfisher3_candle_small_group_melted_c_complex"
                  use_spotlight_colour="false">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <light index="0"
                 brightness="2"
                 radius="3.5" />
          <light index="2"
                 brightness="2"
                 radius="3" />
        </override>

        <override tag_name="LR_UltraPT_Kingfisher3_candle_med_melted_complex"
                  brightness="2"
                  radius="3.75">
          <match mode="exact">candle_med_melted_complex.w2ent</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>