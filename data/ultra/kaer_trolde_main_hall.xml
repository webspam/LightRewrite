<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <light_rewrite>
      <!-- Ultra: Kaer Trolde - Main Hall -->
      <overrides profile_name="Ultra"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\castle_interior\main_hall_decoration_default\lights_fx.w2l</match>
        </matches>
        <override tag_name="LR_Ultra_KaerTrolde_MainHall_braziers_wall_chain_bounce_1_light"
                  brightness="40"
                  radius="6"
                  attenuation="0.85">
          <match mode="exact">braziers_wall_chain_bounce_1_light.w2ent</match>
          <offset x="-1.188"
                  y="-0.039"
                  z="-0.83" />
        </override>

        <override tag_name="LR_Ultra_KaerTrolde_MainHall_braziers_wall_wire_bounce_on_off"
                  brightness="40"
                  radius="5"
                  attenuation="0.85">
          <match mode="exact">braziers_wall_wire_bounce_on_off.w2ent</match>
          <offset x="-1.42606"
                  y="0"
                  z="0.44" />
        </override>

        <override tag_name="LR_Ultra_KaerTrolde_MainHall_chandelier_bright"
                  brightness="30"
                  radius="8.5"
                  attenuation="1">
          <match mode="exact">chandelier_bright.w2ent</match>
          <offset x="0"
                  y="0"
                  z="-1.77" />
        </override>

        <override tag_name="LR_Ultra_KaerTrolde_MainHall_chandelier_bright_noshadow_2"
                  brightness="30"
                  radius="8.94">
          <match mode="exact">chandelier_bright_noshadow.w2ent</match>
        </override>

        <override tag_name="LR_Ultra_KaerTrolde_MainHall_fireplace_grate"
                  radius="7"
                  attenuation="0.8">
          <match mode="exact">fireplace_grate.w2ent</match>
        </override>
      </overrides>

      <overrides profile_name="Ultra"
                 weight="20">
        <override tag_name="LR_Ultra_KaerTrolde_MainHall_braziers_wall_wire_bounce_on_off_2"
                  radius="5"
                  attenuation="0.85">
          <match mode="exact">braziers_wall_wire_bounce_on_off.w2ent</match>
          <match type="layer"
                 mode="exact">levels\skellige\ard_skellig\kaer_trolde\castle_interior\main_hall_decoration_default_floor\lights_fx.w2l</match>
          <offset x="-1.42606"
                  y="0"
                  z="0.55" />
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>