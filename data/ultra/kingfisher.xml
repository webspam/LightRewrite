<?xml version="1.0" encoding="UTF-8"?>
<redxml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../LightRewriteDefinitions.xsd">
  <custom>
    <!-- Ultra -->
    <light_rewrite>
      <!-- Kingfisher -->
      <overrides profile_name="Ultra"
                 weight="20">
        <matches>
          <match type="layer">levels\novigrad\novigrad\zimorodek_inn\</match>
        </matches>

        <!-- Shadows -->
        <override tag_name="LR_Ultra_Kingfisher_Shadows">
          <shadows min_fade_distance="20"
                   min_fade_range="20" />
        </override>

        <!-- Bar, Barrel -->
        <override tag_name="LR_Ultra_Kingfisher_CandleGroupC">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <light index="0"
                 brightness="2"
                 radius="2" />
          <light index="1"
                 brightness="2"
                 radius="5" />
          <light index="2"
                 brightness="2"
                 radius="2" />
        </override>

        <override tag_name="LR_Ultra_Kingfisher_CandleHolderFancy"
                  brightness="4"
                  radius="4"
                  attenuation="1"
                  default_state="on">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <!-- Stage -->
        <override tag_name="LR_Ultra_Kingfisher_CandleGroupD">
          <any>
            <match mode="exact">candle_small_group_melted_d.w2ent</match>
            <match mode="exact">candle_small_group_melted_b.w2ent</match>
          </any>
          <light index="0"
                 brightness="2"
                 radius="5" />
          <light index="1"
                 brightness="2"
                 radius="1.5" />
        </override>

        <override tag_name="LR_Ultra_Kingfisher_Candelabra"
                  brightness="10.23"
                  attenuation="1">
          <any>
            <match mode="exact">candelabra_complex.w2ent</match>
            <match mode="exact">candelabra.w2ent</match>
          </any>
          <spotlight>
            <lum exclude_scene="true" />
          </spotlight>
        </override>

        <override tag_name="LR_Ultra_Kingfisher_LargeCandleHolderB"
                  brightness="5"
                  radius="5.5">
          <match mode="exact">candle_holder_large_wood_b_complex.w2ent</match>
        </override>

        <override tag_name="LR_Ultra_Kingfisher_CandelabraStanding"
                  radius="4.25"
                  brightness="9.52"
                  rewriter_type="LRT_FxAlign">
          <match mode="exact">candelabra_standing.w2ent</match>
          <shadows min_fade_distance="20"
                   min_fade_range="15" />
          <fire_fx_offset x="0"
                          y="0"
                          z="0.2" />
        </override>

        <!-- Candelabra on a Stick - Penthouse -->
        <override tag_name="LR_Ultra_Kingfisher_Penthouse_CandleabraOnAStick"
                  radius="5.5"
                  attenuation="1">
          <match mode="exact">candelabra_standing_complex.w2ent</match>
          <!-- building\lights.w2l -->
        </override>
      </overrides>

      <!-- Kingfisher Inn - First floor, Northeast Room (3) -->
      <overrides profile_name="Ultra"
                 weight="20">
        <matches>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\zimorodek_inn\building\northeast_room_q310\lights.w2l</match>
        </matches>

        <!-- Q310 Candle - End of Bed -->
        <override tag_name="LR_Ultra_Kingfisher3_CandleEndOfBed"
                  radius="2">
          <match mode="exact">candleholder_fancy_complex.w2ent</match>
        </override>

        <!-- Fix raster shadow glitches -->
        <override tag_name="LR_Ultra_Kingfisher3_candle_small_group_melted_d_complex">
          <match mode="exact">candle_small_group_melted_d_complex.w2ent</match>
          <light index="0"
                 brightness="3.5" />
          <light index="1"
                 brightness="2.5"
                 radius="1">
            <shadows casting_mode="Normal" />
          </light>
        </override>
        <override tag_name="LR_Ultra_Kingfisher3_candle_small_group_melted_complex">
          <match mode="exact">candle_small_group_melted_complex.w2ent</match>
          <light index="1"
                 radius="1" />
        </override>
        <override tag_name="LR_Ultra_Kingfisher3_candle_small_group_melted_c_complex">
          <match mode="exact">candle_small_group_melted_c_complex.w2ent</match>
          <light index="0"
                 brightness="2.5"
                 radius="1" />
          <light index="1"
                 brightness="4"
                 radius="3" />
          <light index="2"
                 brightness="2.5"
                 radius="1" />
        </override>
      </overrides>

      <!-- Iron Chandeliers - Exterior Balconies -->
      <overrides profile_name="Ultra"
                 weight="20">
        <override tag_name="LR_Ultra_Kingfisher_ChandelierSmallNoShadow"
                  brightness="50"
                  radius="5">
          <match mode="exact">chandelier_small_noshadow.w2ent</match>
          <match type="layer"
                 mode="exact">levels\novigrad\novigrad\main_square\lights_exterior.w2l</match>
        </override>
      </overrides>
    </light_rewrite>
  </custom>
</redxml>